{
  "name": "construcciones-mbl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web corporativa en Astro (SSG) para Construcciones MBL en Asturias con SEO, GEO y AEO.",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node --experimental-require-module ./node_modules/astro/astro.js check",
    "check:functions": "tsc -p functions/tsconfig.json --noEmit",
    "check:api": "tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "python scripts/verify-build.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.3.0",
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "astro": "^5.7.0",
    "sharp": "^0.34.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^4.20250401.0",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}