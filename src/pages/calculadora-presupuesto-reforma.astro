---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResumenDirecto from '../components/ResumenDirecto.astro';
import BudgetCalculator from '../components/tools/BudgetCalculator.astro';
import BloqueFaq from '../components/BloqueFaq.astro';
import { EMPRESA } from '../data/empresa';
import {
  buildBreadcrumbNode,
  buildFaqNode,
  buildOrganizationNode,
  buildWebApplicationNode,
} from '../lib/schema';

const slug = 'calculadora-presupuesto-reforma';
const pageUrl = `${EMPRESA.dominio}/${slug}/`;
const title = 'Calculadora de Presupuesto de Reforma en Asturias (2026)';
const description =
  'Calcula el presupuesto integral de tu reforma en Asturias con PEM, ICIO por concejo, IVA (10% o 21%), desglose por partidas y plazo en semanas.';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Calculadora de presupuesto', url: `/${slug}/` },
];

const faqs = [
  {
    pregunta: '¿Cómo se calcula el PEM y el ICIO en la calculadora de reformas?',
    respuesta:
      'El Presupuesto de Ejecución Material (PEM) se estima dividiendo el subtotal de ejecución por contrata (sin IVA ni honorarios técnicos) entre 1,19 para descontar el 13 % de Gastos Generales y el 6 % de Beneficio Industrial. Sobre ese PEM se aplica el tipo real de ICIO de tu concejo en Asturias.',
  },
  {
    pregunta: '¿Cuándo se aplica el IVA reducido del 10 % en reformas de vivienda?',
    respuesta:
      'Conforme al art. 91 de la Ley 37/1992 del IVA, se aplica el 10 % cuando el promotor es un particular en vivienda de más de 2 años y los materiales aportados por la constructora no superan el 40 % de la base imponible. En locales comerciales, inversores o proyecto técnico de arquitecto aplica el 21 %.',
  },
  {
    pregunta: '¿Qué sobrecostes reales tiene una reforma en Asturias frente a la media nacional?',
    respuesta:
      'En Asturias influyen la logística según el concejo, la ausencia de ascensor en fincas antiguas, y patologías frecuentes del clima atlántico como humedades por capilaridad o rehabilitación de cubiertas y refuerzos estructurales en casas de piedra.',
  },
];

const faqNode = buildFaqNode(faqs, pageUrl);
const schemaGraph = [
  buildOrganizationNode(),
  buildWebApplicationNode({
    name: 'Calculadora de Presupuesto de Reforma en Asturias',
    description,
    url: pageUrl,
    applicationCategory: 'FinanceApplication',
  }),
  buildBreadcrumbNode(breadcrumbs, pageUrl),
  ...(faqNode ? [faqNode] : []),
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} schemaGraph={schemaGraph}>
  <Header slot="header" mode="solid" currentPath={`/${slug}/`} />

  <section class="sec">
    <Breadcrumbs items={breadcrumbs} />
    <span class="sec-kicker">Módulo 1 · Presupuesto + PEM + ICIO + IVA 2026</span>
    <h1 class="sec-title" style="font-size:clamp(36px,4.8vw,62px)">
      Calculadora de Presupuesto de Reforma en Asturias
    </h1>

    <ResumenDirecto
      texto="Configura en 3 pasos el alcance de tu obra, concejo en Asturias, calidades, patologías frecuentes y perfil fiscal para conocer al instante tu inversión total estimada con PEM, ICIO municipal, IVA (10 % o 21 %) y plazo orientativo en semanas."
    />

    <div style="margin-top:28px">
      <BudgetCalculator />
    </div>

    <div style="margin-top:44px;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
      <a class="zona-card" href="/licencia-obra-asturias/" style="padding:20px">
        <h3>Simulador de Licencias e ICIO</h3>
        <p>Comprueba si necesitas Declaración Responsable, Obra Menor u Obra Mayor según el TROTU en tu concejo.</p>
      </a>
      <a class="zona-card" href="/calculadora-deducciones-irpf-reforma/" style="padding:20px">
        <h3>Deducciones IRPF Eficiencia</h3>
        <p>Calcula cuánto puedes recuperar en tu Declaración de la Renta (20 %, 40 % o 60 %) tras la reforma.</p>
      </a>
      <a class="zona-card" href="/comparador-aerotermia-asturias/" style="padding:20px">
        <h3>Comparador de Aerotermia</h3>
        <p>Compara tu caldera actual frente a aerotermia según la zona climática CTE de tu municipio.</p>
      </a>
    </div>
  </section>

  <BloqueFaq
    titulo="Preguntas Frecuentes sobre Presupuestos, PEM e IVA en Asturias"
    faqs={faqs}
  />
</BaseLayout>
