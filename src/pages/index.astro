---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HeroQuickSelector from "../components/HeroQuickSelector.astro";
import BloqueFaq from "../components/BloqueFaq.astro";
import EquipoEEAT from "../components/EquipoEEAT.astro";
import {
  EMPRESA,
  FAQS_GENERALES,
  isPromoDuchaActive,
  isDetalleProyectosActive,
} from "../data/empresa";
import { getResenasHome } from "../data/google-reviews";
import {
  buildOrganizationNode,
  buildWebSiteNode,
  buildFaqNode,
} from "../lib/schema";

import heroHomeImg from "../assets/images/servicios/hero-home-construcciones-mbl.webp";
import storyImg1 from "../assets/images/proyectos/obra-reforma-integral-1.webp";
import storyImg2 from "../assets/images/proyectos/obra-bano-mbl-wide.webp";
import darkImg from "../assets/images/proyectos/proyecto-local-comercial-gijon-1.webp";
import galImgMain from "../assets/images/proyectos/obra-bano-mbl-14.webp";
import galImgSide1 from "../assets/images/proyectos/obra-cocina-mbl-1.webp";
import galImgSide2 from "../assets/images/proyectos/proyecto-alicatado-bano-1.webp";
import galImgAlt1 from "../assets/images/proyectos/obra-cocina-mbl-2.webp";
import galImgAlt2 from "../assets/images/proyectos/obra-ducha-mampara.webp";
import testiImg from "../assets/images/proyectos/proyecto-bano-moderno-asturias.webp";

const servicios = (await getCollection("servicios")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const localidades = await getCollection("localidades");
const proyectosDestacados = (await getCollection("proyectos"))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);
const ultimosArticulos = (await getCollection("blog"))
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished))
  .slice(0, 3);
const promos = await getCollection("promociones");
const promoDucha = promos.find((p) => p.data.id === "plato-ducha-48h");
const showPromoDucha = isPromoDuchaActive(promoDucha?.data.activa ?? true);
const testimonios = await getResenasHome();

const fasesMetodo = [
  {
    paso: "Fase 01 · Diagnóstico en obra",
    titulo: "Visita técnica gratuita en cualquier punto de Asturias",
    texto:
      "Nos desplazamos a tu vivienda o local en Gijón, Oviedo, Avilés o concejos cercanos para tomar medidas reales, revisar instalaciones y escuchar tus prioridades.",
  },
  {
    paso: "Fase 02 · Transparencia total",
    titulo: "Presupuesto cerrado y desglosado en 48 horas",
    texto:
      "Recibes cada capítulo detallado por partidas y materiales acordados. Sin conceptos genéricos ni desviaciones imprevistas durante la ejecución.",
  },
  {
    paso: "Fase 03 · Ejecución coordinada",
    titulo: "Dirección técnica propia y cumplimiento de plazos",
    texto:
      "Coordinamos todos los gremios (albañilería, fontanería, electricidad, carpintería y clima) con un único responsable asignado y seguimiento continuo.",
  },
  {
    paso: "Fase 04 · Respaldo real",
    titulo: "Entrega llave en mano con garantía por escrito",
    texto:
      "Revisamos contigo cada acabado antes de la entrega final y emitimos tu garantía por escrito: hasta 3 años en reformas y 10 años en construcción estructural.",
  },
];

const galeriaSlides = [
  {
    src: galImgMain,
    alt: "Reforma completa de baño moderno con ducha y mueble suspendido en Asturias",
  },
  {
    src: galImgAlt1,
    alt: "Cocina reformada a medida con mobiliario luminoso en Asturias",
  },
  {
    src: galImgAlt2,
    alt: "Cambio de bañera por plato de ducha antideslizante con mampara en Asturias",
  },
];

const title = "Reformas Integrales y Construcción en Asturias | MBL";
const description =
  "Empresa de reformas integrales, cocinas, baños y construcción en Asturias (Gijón, Oviedo y Avilés). Presupuesto cerrado en 48 h y garantía por escrito.";
const pageUrl = `${EMPRESA.dominio}/`;

const faqNode = buildFaqNode(FAQS_GENERALES, pageUrl);
const schemaGraph = [
  buildOrganizationNode(),
  buildWebSiteNode(),
  ...(faqNode ? [faqNode] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  schemaGraph={schemaGraph}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"
  >
    <defs>
      <symbol id="i-clk" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </symbol>
      <symbol id="i-ur" viewBox="0 0 24 24">
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </symbol>
      <symbol id="i-lt" viewBox="0 0 24 24">
        <path d="m15 18-6-6 6-6" />
      </symbol>
      <symbol id="i-rt" viewBox="0 0 24 24">
        <path d="m9 18 6-6-6-6" />
      </symbol>
    </defs>
  </svg>

  <!-- ================= 1. HERO ================= -->
  <header class="hero" id="inicio" slot="header">
    <Image
      src={heroHomeImg}
      alt="Reforma integral de vivienda luminosa en Asturias ejecutada por Construcciones MBL"
      class="hero-bg"
      widths={[640, 1024, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <Header mode="overlay" currentPath="/" />

    <div class="hero-stack">
      <div class="hero-main">
        <small>Gijón · Oviedo · Avilés · Todo el Principado de Asturias</small>
        <h1>
          Reformas Integrales y Construcción en Asturias con Presupuesto Cerrado
        </h1>

        <p class="hero-lead-right">
          Transformamos viviendas, cocinas, baños y locales comerciales en todo
          el Principado de Asturias con presupuesto cerrado por partidas,
          dirección técnica diaria y garantía por escrito.
        </p>
      </div>

      <div class="hero-bottom">
        <div class="hero-tag-row">
          <p class="tag">
            +20 años de oficio · Dirección técnica propia · Garantía por escrito
          </p>
        </div>

        <HeroQuickSelector />
      </div>
    </div>
  </header>

  <!-- ================= 2. NUESTRA HISTORIA — ZIG-ZAG 2 FILAS ================= -->
  <section
    class="sec story-zigzag"
    id="historia"
    aria-labelledby="historia-title"
    data-reveal
  >
    <div class="story-row">
      <div class="story-photo">
        <Image
          src={storyImg1}
          alt="Salón reformado integralmente en Asturias con carpintería blanca"
          widths={[520, 860]}
          sizes="(max-width: 900px) 100vw, 46vw"
        />
      </div>

      <div>
        <span class="sec-kicker">Desde 2005 en Asturias</span>
        <h2 class="sec-title" id="historia-title">
          Nuestra Historia
        </h2>
        <p class="story-copy">
          En Construcciones MBL nacimos con un objetivo claro: eliminar la
          incertidumbre que suele acompañar a una obra. Combinamos más de dos
          décadas de oficio en Asturias con una planificación técnica rigurosa
          para que reformar tu piso o construir tu casa sea un proceso
          predecible y limpio.
        </p>
        <p class="story-copy">
          Desde nuestra oficina técnica en Cristasa (Gijón), gestionamos
          licencias municipales, aislamiento frente a la humedad atlántica y
          acabados duraderos con garantía por escrito.
        </p>
      </div>
    </div>

    <div class="story-row">
      <div class="stats" aria-label="Cifras clave de Construcciones MBL">
        {EMPRESA.metricas.map((m) => (
          <div class="stat">
            <strong>{m.valor}</strong>
            <span>{m.etiqueta}</span>
          </div>
        ))}
      </div>

      <div class="story-photo">
        <Image
          src={storyImg2}
          alt="Baño contemporáneo reformado con plato de ducha en Asturias"
          widths={[520, 860]}
          sizes="(max-width: 900px) 100vw, 46vw"
        />
      </div>
    </div>
  </section>

  <!-- ================= 3. NUESTROS SERVICIOS — TOP PICKS ================= -->
  <section
    class="sec"
    id="servicios"
    style="padding-top:16px"
    aria-labelledby="servicios-title"
    data-reveal
  >
    <span class="sec-kicker">Especialidades llave en mano</span>
    <h2 class="sec-title" id="servicios-title">
      Nuestros Servicios
    </h2>

    <div
      class="tabs"
      role="tablist"
      aria-label="Filtrar servicios por especialidad"
    >
      <button
        type="button"
        class="tab on"
        role="tab"
        aria-selected="true"
        data-service-tab="todos"
      >
        Todos los servicios
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        aria-selected="false"
        data-service-tab="reformas"
      >
        Reformas de vivienda
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        aria-selected="false"
        data-service-tab="banos-cocinas"
      >
        Baños y cocinas
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        aria-selected="false"
        data-service-tab="obra-locales"
      >
        Vivienda nueva y locales
      </button>
    </div>

    <div class="cards" id="services-cards-grid">
      {servicios.map((srv) => (
        <article class="card" data-service-cat={srv.data.categoriaTab}>
          <Image
            src={srv.data.imagen}
            alt={srv.data.imagenAlt}
            class="card-img"
            widths={[440, 760]}
            sizes="(max-width: 900px) 100vw, 31vw"
          />
          <span class="card-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true">
              <use href="#i-clk" />
            </svg>
            <span>{srv.data.plazoVisible}</span>
          </span>
          <a
            class="card-icon"
            href={`/${srv.data.slug}/`}
            aria-label={`Ver ${srv.data.tituloCorto}`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <use href="#i-ur" />
            </svg>
          </a>
          <div class="txt">
            <h3>
              <a href={`/${srv.data.slug}/`}>{srv.data.tituloCorto}</a>
            </h3>
            <p>{srv.data.metaDescription}</p>
          </div>
          <a class="price" href={`/${srv.data.slug}/`}>
            {srv.data.precioDesde}
          </a>
        </article>
      ))}
    </div>

    {showPromoDucha && promoDucha && (
      <div class="promo-strip">
        <div>
          <span class="sec-kicker" style="margin-bottom:8px">
            Servicio Exprés 48 Horas · Disponible en toda Asturias
          </span>
          <h3>{promoDucha.data.titulo}</h3>
          <p>{promoDucha.data.subtitulo}</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <span class="pill" style="pointer-events:none">
            {promoDucha.data.precioDesde}
          </span>
          <a
            class="pill pill-white"
            href="/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/"
          >
            Ver servicio 48 h →
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- ================= 4. BLOQUE OSCURO MÉTODO MBL ================= -->
  <section class="dark" aria-labelledby="metodo-title" data-reveal>
    <div class="dark-head">
      <h2 id="metodo-title">
        Construimos con presupuesto cerrado y garantía escrita
      </h2>
    </div>

    <div class="dark-grid">
      <div class="dark-img-wrap">
        <Image
          src={darkImg}
          alt="Equipo técnico de Construcciones MBL ejecutando obra con nivelación láser en Asturias"
          widths={[560, 920]}
          sizes="(max-width: 900px) 100vw, 48vw"
        />
      </div>

      <div>
        <div id="method-steps-container" aria-live="polite">
          {fasesMetodo.map((f, idx) => (
            <div class="method-step" data-method-idx={idx} hidden={idx !== 0}>
              <span class="sec-kicker">{f.paso}</span>
              <h3>{f.titulo}</h3>
              <p>{f.texto}</p>
            </div>
          ))}
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a class="pill" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
            Solicitar presupuesto cerrado
          </a>
          <a class="pill pill-white" href="/servicios/">
            Ver servicios
          </a>
        </div>
      </div>
    </div>

    <div class="dark-bottom-nav">
      <button
        type="button"
        class="arr"
        aria-label="Fase anterior"
        data-method-prev
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <use href="#i-lt" />
        </svg>
      </button>
      <button
        type="button"
        class="arr on"
        aria-label="Fase siguiente"
        data-method-next
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <use href="#i-rt" />
        </svg>
      </button>
    </div>
  </section>

  <!-- ================= 5. PROYECTOS DESTACADOS ================= -->
  <section class="sec" aria-labelledby="proyectos-home-title" data-reveal>
    <span class="sec-kicker">Obras reales ejecutadas en Asturias</span>
    <h2 class="sec-title" id="proyectos-home-title">
      Proyectos Destacados
    </h2>

    <div class="choice-grid" id="choice-projects-grid">
      {proyectosDestacados.map((proy, idx) => {
        const hasDetail = isDetalleProyectosActive(proy.data.detalleActivo);
        const proyHref = hasDetail
          ? `/proyectos/${proy.data.slug}/`
          : "/proyectos/";
        return (
          <article class="card" data-choice-idx={idx} hidden={idx >= 2}>
            <Image
              src={proy.data.imagen}
              alt={proy.data.imagenAlt}
              class="card-img"
              widths={[540, 860]}
              sizes="(max-width: 900px) 100vw, 46vw"
            />
            <span class="card-badge">
              {proy.data.municipio} · {proy.data.superficieM2}
            </span>
            <a
              class="card-icon"
              href={proyHref}
              aria-label={`Ver ${proy.data.titulo}`}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <use href="#i-ur" />
              </svg>
            </a>
            <div class="txt">
              <h3>
                <a href={proyHref}>{proy.data.titulo}</a>
              </h3>
              <p>{proy.data.resumen}</p>
            </div>
          </article>
        );
      })}
    </div>

    <div class="choice-nav-row">
      <div class="ctrl" style="margin-top:0">
        <button
          type="button"
          class="arr light on"
          aria-label="Proyectos anteriores"
          data-proj-prev
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#i-lt" />
          </svg>
        </button>
        <button
          type="button"
          class="arr light"
          aria-label="Siguientes proyectos"
          data-proj-next
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#i-rt" />
          </svg>
        </button>
      </div>
      <a class="btn-outline" href="/proyectos/">
        Ver todos los proyectos →
      </a>
    </div>
  </section>

  <!-- ================= 6. GALERÍA DE OBRAS ================= -->
  <section
    class="sec gallery-section"
    style="padding-top:8px"
    aria-labelledby="galeria-home-title"
    data-reveal
  >
    <h2 class="sec-title" id="galeria-home-title">
      Explora Nuestra Galería de Obras
    </h2>

    <div class="gallery">
      <div class="gallery-side">
        <div class="photo-tile">
          <Image
            src={galImgSide1}
            alt="Cocina moderna reformada a medida en Asturias"
            widths={[400, 680]}
            sizes="(max-width: 900px) 50vw, 30vw"
          />
        </div>
        <div class="photo-tile">
          <Image
            src={galImgSide2}
            alt="Alicatado porcelánico rectificado ejecutado por Construcciones MBL"
            widths={[400, 680]}
            sizes="(max-width: 900px) 50vw, 30vw"
          />
        </div>
      </div>

      <div class="gallery-main" id="gallery-main-slides" aria-live="polite">
        {galeriaSlides.map((img, idx) => (
          <Image
            src={img.src}
            alt={img.alt}
            widths={[640, 1080]}
            sizes="(max-width: 900px) 100vw, 60vw"
            data-gal-idx={idx}
            hidden={idx !== 0}
          />
        ))}
      </div>
    </div>

    <div class="gallery-nav-row">
      <button
        type="button"
        class="arr light"
        aria-label="Foto anterior"
        data-gal-prev
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <use href="#i-lt" />
        </svg>
      </button>
      <button
        type="button"
        class="arr light on"
        aria-label="Foto siguiente"
        data-gal-next
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <use href="#i-rt" />
        </svg>
      </button>
    </div>

    <div class="gallery-ghost" aria-hidden="true">
      {EMPRESA.marcasAgua.footer}
    </div>
  </section>

  <!-- ================= 7. TESTIMONIOS REALES VERIFICADOS ================= -->
  <section class="sec testi" aria-labelledby="testi-title" data-reveal>
    <div>
      <span class="sec-kicker">
        {EMPRESA.googleBusiness.ratingValor} / 5 en Google ·{" "}
        {EMPRESA.googleBusiness.totalResenas} reseñas verificadas
      </span>
      <h2 class="sec-title" id="testi-title" style="margin-bottom:20px">
        Opiniones reales de clientes en Asturias
      </h2>

      <div class="testi-card">
        <div class="testi-card-top">
          <div class="testi-stars" role="img" aria-label="Valoración 5 de 5 estrellas">
            <svg
              width="88"
              height="16"
              viewBox="0 0 110 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M10 1l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6L1.2 7.4l6.1-.9zM32 1l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6L23.2 7.4l6.1-.9zM54 1l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6L45.2 7.4l6.1-.9zM76 1l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6L67.2 7.4l6.1-.9zM98 1l2.7 5.5 6.1.9-4.4 4.3 1 6-5.4-2.8-5.4 2.8 1-6L89.2 7.4l6.1-.9z" />
            </svg>
          </div>
          <span class="testi-verified">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            <span>Cliente verificado en Google</span>
          </span>
        </div>

        <div id="testi-slides" aria-live="polite">
          {testimonios.map((t, idx) => (
            <blockquote
              class="testi-slide"
              data-testi-idx={idx}
              hidden={idx !== 0}
            >
              <h3>“{t.titulo}”</h3>
              <p class="testi-quote">{t.cita}</p>

              <footer class="who">
                <div class="who-id">
                  {t.avatarUrl ? (
                    <img
                      class="who-avatar-img"
                      src={t.avatarUrl}
                      alt={`Foto de perfil de ${t.autor} en Google`}
                      width="44"
                      height="44"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <span class="who-avatar" aria-hidden="true">
                      {t.autor.slice(0, 1)}
                    </span>
                  )}
                  <div>
                    <strong>{t.autor}</strong>
                    <small>
                      {t.tipoObra} · {t.municipio}
                    </small>
                  </div>
                </div>
                {idx === 0 && (
                  <a
                    href={EMPRESA.googleBusiness.hasMap}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="font-size:12.5px;font-weight:600;color:var(--color-primary);text-decoration:underline"
                  >
                    Comprobar en Google Maps ↗
                  </a>
                )}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>

      <div class="ctrl">
        <button
          type="button"
          class="arr light on"
          aria-label="Opinión anterior"
          data-testi-prev
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#i-lt" />
          </svg>
        </button>
        <button
          type="button"
          class="arr light"
          aria-label="Opinión siguiente"
          data-testi-next
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <use href="#i-rt" />
          </svg>
        </button>
        <a
          class="btn-outline"
          href={EMPRESA.googleBusiness.hasMap}
          target="_blank"
          rel="noopener noreferrer"
          style="margin-left:8px"
        >
          Ver las {EMPRESA.googleBusiness.totalResenas} reseñas en Google →
        </a>
      </div>
    </div>

    <div class="testi-img">
      <Image
        src={testiImg}
        alt="Resultado de reforma ejecutada con opiniones verificadas de clientes en Asturias"
        widths={[540, 880]}
        sizes="(max-width: 900px) 100vw, 48vw"
      />
      <div class="gbp-badge-card">
        <div class="gbp-score">
          <strong>{EMPRESA.googleBusiness.ratingValor}</strong>
          <div>
