---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroQuickSelector from '../components/HeroQuickSelector.astro';
import Icon from '../components/Icon.astro';
import BloqueFaq from '../components/BloqueFaq.astro';
import EquipoEEAT from '../components/EquipoEEAT.astro';
import CtaSimulador from '../components/CtaSimulador.astro';
import {
  EMPRESA,
  FAQS_GENERALES,
  TESTIMONIOS_REALES,
  isPromoDuchaActive,
} from '../data/empresa';
import {
  buildOrganizationNode,
  buildWebSiteNode,
  buildFaqNode,
} from '../lib/schema';

import heroHomeImg from '../assets/images/servicios/hero-home-construcciones-mbl.webp';
import storyImg1 from '../assets/images/proyectos/obra-reforma-integral-1.webp';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const localidades = await getCollection('localidades');
const proyectosDestacados = (await getCollection('proyectos'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);
const ultimosArticulos = (await getCollection('blog'))
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished))
  .slice(0, 3);
const promos = await getCollection('promociones');
const promoDucha = promos.find((p) => p.data.id === 'plato-ducha-48h');
const showPromoDucha = isPromoDuchaActive(promoDucha?.data.activa ?? true);

const fasesMetodo = [
  {
    num: '01',
    paso: 'Diagnóstico en obra',
    titulo: 'Visita técnica gratuita en toda Asturias',
    texto:
      'Medición real en tu vivienda o local en Gijón, Oviedo, Avilés o concejos próximos para revisar instalaciones y definir prioridades.',
  },
  {
    num: '02',
    paso: 'Transparencia total',
    titulo: 'Presupuesto cerrado por partidas en 48 h',
    texto:
      'Detallamos cada capítulo, material y plazo antes de iniciar la obra, sin conceptos genéricos ni desviaciones imprevistas.',
  },
  {
    num: '03',
    paso: 'Ejecución coordinada',
    titulo: 'Dirección técnica propia y gremios propios',
    texto:
      'Coordinamos albañilería, fontanería, electricidad, carpintería y clima bajo un único responsable técnico en obra.',
  },
  {
    num: '04',
    paso: 'Respaldo real',
    titulo: 'Entrega llave en mano con garantía escrita',
    texto:
      'Revisamos cada acabado junto contigo antes de entregar hasta 3 años de garantía en reformas y 10 años en estructura.',
  },
];

const resenasDestacadas = TESTIMONIOS_REALES.slice(0, 3);

const title = 'Reformas Integrales y Construcción en Asturias | MBL';
const description =
  'Empresa de reformas integrales, cocinas, baños y construcción en Asturias (Gijón, Oviedo y Avilés). Presupuesto cerrado en 48 h y garantía por escrito.';
const pageUrl = `${EMPRESA.dominio}/`;

const faqNode = buildFaqNode(FAQS_GENERALES, pageUrl);
const schemaGraph = [
  buildOrganizationNode(),
  buildWebSiteNode(),
  ...(faqNode ? [faqNode] : []),
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} schemaGraph={schemaGraph}>
  <Header currentPath="/" />

  <!-- ================= 1. HERO CORPORATIVO ASIMÉTRICO ================= -->
  <section class="hero-corp" id="inicio" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-copy-col">
        <span class="hero-eyebrow">
          <Icon name="map-pin" size={15} />
          <span>Gijón · Oviedo · Avilés · Todo el Principado de Asturias</span>
        </span>

        <h1 id="hero-title">
          Reformas integrales y construcción en Asturias con presupuesto cerrado
        </h1>

        <p class="hero-lead">
          Ejecutamos reformas de viviendas, cocinas, baños y locales comerciales desde nuestra oficina técnica en Gijón, con partidas detalladas, planificación real y garantía por escrito.
        </p>

        <div class="hero-ctas">
          <a class="btn-primary" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
            <span>Calcula el precio de tu reforma</span>
            <Icon name="arrow-right" size={17} />
          </a>
          <a class="btn-secondary" href="/contacto/">
            <span>Solicitar visita técnica gratuita</span>
          </a>
        </div>

        <div class="hero-trust-row" aria-label="Garantías corporativas">
          <div class="hero-trust-item">
            <span class="hero-trust-icon"><Icon name="clock" size={16} /></span>
            <div>
              <strong>Presupuesto en 48 h</strong>
              <span>Desglosado por partidas</span>
            </div>
          </div>
          <div class="hero-trust-item">
            <span class="hero-trust-icon"><Icon name="shield-check" size={16} /></span>
            <div>
              <strong>Garantía por escrito</strong>
              <span>3 años reforma · 10 estructural</span>
            </div>
          </div>
          <div class="hero-trust-item">
            <span class="hero-trust-icon"><Icon name="award" size={16} /></span>
            <div>
              <strong>{EMPRESA.googleBusiness.ratingValor} / 5 en Google</strong>
              <span>{EMPRESA.googleBusiness.totalResenas} reseñas verificadas</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-visual-col">
        <div class="hero-photo-frame">
          <Image
            src={heroHomeImg}
            alt="Reforma integral de vivienda luminosa en Asturias ejecutada por Construcciones MBL"
            widths={[640, 1024, 1440]}
            sizes="(max-width: 900px) 100vw, 45vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <HeroQuickSelector />
      </div>
    </div>
  </section>

  <!-- ================= 2. BANDA DE CIFRAS CORPORATIVAS ================= -->
  <section class="metrics-band" aria-label="Cifras y solvencia de Construcciones MBL">
    <div class="metrics-grid">
      {EMPRESA.metricas.map((m) => (
        <div class="metric-item">
          <strong>{m.valor}</strong>
          <span>{m.etiqueta}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= 3. CATÁLOGO DE SERVICIOS ================= -->
  <section class="sec" id="servicios" aria-labelledby="servicios-title">
    <div class="sec-header-row" style="margin-bottom:8px">
      <div>
        <span class="sec-kicker">Especialidades llave en mano</span>
        <h2 class="sec-title" id="servicios-title">Servicios de reformas y construcción en Asturias</h2>
      </div>
      <a class="btn-outline" href="/servicios/">
        <span>Ver comparativa y tarifas</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="tabs" role="tablist" aria-label="Filtrar servicios por especialidad">
      <button type="button" class="tab on" role="tab" aria-selected="true" data-service-tab="todos">
        Todos los servicios
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="reformas">
        Reformas de vivienda
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="banos-cocinas">
        Baños y cocinas
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="obra-locales">
        Vivienda nueva y locales
      </button>
    </div>

    <div class="cards" id="services-cards-grid">
      {servicios.map((srv) => (
        <article class="card" data-service-cat={srv.data.categoriaTab}>
          <div class="card-media">
            <Image
              src={srv.data.imagen}
              alt={srv.data.imagenAlt}
              widths={[440, 760]}
              sizes="(max-width: 900px) 100vw, 31vw"
            />
          </div>
          <div class="card-body">
            <div class="card-meta-row">
              <span class="card-badge">
                <Icon name="clock" size={14} />
                <span>{srv.data.plazoVisible}</span>
              </span>
              <span class="card-price">{srv.data.precioDesde}</span>
            </div>
            <h3>
              <a href={`/${srv.data.slug}/`}>{srv.data.tituloCorto}</a>
            </h3>
            <p>{srv.data.metaDescription}</p>
            <a class="card-link" href={`/${srv.data.slug}/`}>
              <span>Ver alcance y tarifas</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>
      ))}
    </div>

    {showPromoDucha && promoDucha && (
      <div class="promo-strip">
        <div>
          <span class="sec-kicker" style="color:var(--warm);margin-bottom:4px">
            Actuación exprés 48 horas · Disponible en toda Asturias
          </span>
          <h3>{promoDucha.data.titulo}</h3>
          <p>{promoDucha.data.subtitulo}</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <span class="pill" style="pointer-events:none">{promoDucha.data.precioDesde}</span>
          <a
            class="pill pill-white"
            href="/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/"
          >
            <span>Ver servicio 48 h</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- ================= 4. PROYECTOS DESTACADOS ================= -->
  <section class="sec sec-surface" aria-labelledby="proyectos-home-title">
    <div class="sec-header-row">
      <div>
        <span class="sec-kicker">Obras reales ejecutadas en Asturias</span>
        <h2 class="sec-title" id="proyectos-home-title">Proyectos destacados</h2>
      </div>
      <a class="btn-outline" href="/proyectos/">
        <span>Explorar todos los proyectos</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="zonas-grid">
      {proyectosDestacados.map((proy) => (
        <article class="zona-card">
          <div class="zona-card-img">
            <Image
              src={proy.data.imagen}
              alt={proy.data.imagenAlt}
              widths={[460, 780]}
              sizes="(max-width: 900px) 100vw, 31vw"
            />
          </div>
          <div class="zona-card-body">
            <span class="sec-kicker" style="margin-bottom:0">
              {proy.data.categoriaEtiqueta} · {proy.data.municipio}
            </span>
            <div class="zona-card-head">
              <h3>{proy.data.titulo}</h3>
              <span class="zona-card-price">{proy.data.superficieM2}</span>
            </div>
            <p>{proy.data.resumen}</p>
            <a class="btn-card" href="/proyectos/">
              <span>Ver ficha de obra</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= 5. MÉTODO DE TRABAJO EN 4 PASOS VISIBLES ================= -->
  <section class="method-band" aria-labelledby="metodo-title">
    <div class="sec-header-row">
      <div>
        <span class="sec-kicker">Metodología técnica Construcciones MBL</span>
        <h2 class="sec-title" id="metodo-title">Cómo ejecutamos cada reforma sin desviaciones</h2>
      </div>
      <a class="btn-primary" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
        <span>Solicitar presupuesto cerrado</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="method-grid">
      {fasesMetodo.map((fase) => (
        <article class="method-card">
          <div class="method-num">{fase.num}</div>
          <span class="method-step-label">{fase.paso}</span>
          <h3>{fase.titulo}</h3>
          <p>{fase.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= 6. TRAYECTORIA, EQUIPO E-E-A-T Y RESEÑAS ================= -->
  <section class="sec" id="historia" aria-labelledby="historia-title">
    <div class="story-split">
      <div>
        <span class="sec-kicker">Más de dos décadas de oficio en Asturias</span>
        <h2 class="sec-title" id="historia-title">Empresa constructora de proximidad y control técnico</h2>
        <p class="story-copy">
          En Construcciones MBL trabajamos para eliminar la incertidumbre que suele acompañar a una obra. Combinamos más de veinte años de experiencia en Asturias con planificación por partidas para que reformar tu piso o construir tu vivienda sea un proceso predecible y limpio.
        </p>
        <p class="story-copy">
          Desde nuestra oficina técnica en Cristasa (Gijón), tramitamos declaraciones responsables y licencias municipales, proyectamos aislamientos frente al clima atlántico y supervisamos cada gremio hasta la entrega final.
        </p>

        <ul class="story-highlights">
          <li>
            <Icon name="check" size={18} />
            <span>Visita técnica gratuita y medición real antes de presupuestar</span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>Gestión integral de permisos ante Ayuntamientos y comunidades</span>
          </li>
          <li>
            <Icon name="check" size={18} />
            <span>Garantía escrita de hasta 3 años en reformas y 10 en vivienda nueva</span>
          </li>
        </ul>
      </div>

      <div class="story-media-grid">
        <div class="story-photo">
          <Image
            src={storyImg1}
            alt="Salón reformado integralmente en Asturias con carpintería blanca y pavimentos resistentes"
            widths={[520, 860]}
            sizes="(max-width: 900px) 100vw, 44vw"
          />
        </div>
      </div>
    </div>
  </section>

  <EquipoEEAT compact />

  <section class="sec sec-surface" aria-labelledby="testi-title">
    <div class="sec-header-row">
      <div>
        <span class="sec-kicker">
          {EMPRESA.googleBusiness.ratingValor} / 5 en Google · {EMPRESA.googleBusiness.totalResenas} reseñas verificadas
        </span>
        <h2 class="sec-title" id="testi-title">Opiniones reales de clientes en Asturias</h2>
      </div>
      <a
        class="btn-outline"
        href={EMPRESA.googleBusiness.hasMap}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Ver ficha en Google Maps</span>
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <div class="reviews-grid">
      {resenasDestacadas.map((t) => (
        <article class="review-card">
          <div class="review-stars" aria-label="Valoración de 5 sobre 5">
            <Icon name="star" size={16} />
            <Icon name="star" size={16} />
            <Icon name="star" size={16} />
            <Icon name="star" size={16} />
            <Icon name="star" size={16} />
          </div>
          <h3>{t.titulo}</h3>
          <p class="review-quote">“{t.cita}”</p>
          <footer class="who">
            <span class="who-avatar" aria-hidden="true">{t.autor.slice(0, 1)}</span>
            <div>
              <strong>{t.autor}</strong>
              <small>{t.tipoObra} · {t.municipio}</small>
            </div>
          </footer>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= 7. ZONAS, GUÍAS Y FAQS ================= -->
  <section class="sec" aria-labelledby="zonas-title">
    <span class="sec-kicker">Cobertura local sin sobrecoste de desplazamiento</span>
    <h2 class="sec-title" id="zonas-title">Reformas en Gijón, Oviedo y Avilés</h2>
    <div class="zonas-grid" style="margin-top:24px">
      {localidades.map((loc) => (
        <article class="zona-card">
          <div class="zona-card-img">
            <Image
              src={loc.data.imagen}
              alt={loc.data.imagenAlt}
              widths={[420, 720]}
              sizes="(max-width: 900px) 100vw, 31vw"
            />
          </div>
          <div class="zona-card-body">
            <div class="zona-card-head">
              <h3><a href={`/${loc.data.slug}/`}>Reformas en {loc.data.municipio}</a></h3>
              <span class="zona-card-price">Desde 650 €/m²</span>
            </div>
            <p>{loc.data.subtituloHero}</p>
            <p style="font-size:0.8rem;color:var(--ink-muted)">
              Trámites en {loc.data.ayuntamiento} · Visita técnica 48 h
            </p>
            <a class="btn-card" href={`/${loc.data.slug}/`}>
              <span>Explorar servicios en {loc.data.municipio}</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec" style="padding-top:16px" aria-labelledby="blog-home-title">
    <div class="sec-header-row">
      <div>
        <span class="sec-kicker">Innovación Sostenible · Guías técnicas 2026</span>
        <h2 class="sec-title" id="blog-home-title">Consejos, precios y normativa en Asturias</h2>
      </div>
      <a class="btn-outline" href="/innovacion-sostenible/">
        <span>Ver las 23 guías técnicas</span>
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="zonas-grid">
      {ultimosArticulos.map((post) => (
        <article class="zona-card">
          <div class="zona-card-img">
            <Image
              src={post.data.imagen}
              alt={post.data.imagenAlt}
              widths={[420, 720]}
              sizes="(max-width: 900px) 100vw, 31vw"
            />
          </div>
          <div class="zona-card-body">
            <span class="sec-kicker" style="margin-bottom:0">{post.data.categoriaNombre}</span>
            <h3>
              <a href={`/${post.data.categoria}/${post.data.slug}/`}>{post.data.titulo}</a>
            </h3>
            <p>{post.data.metaDescription}</p>
            <a class="btn-card" href={`/${post.data.categoria}/${post.data.slug}/`}>
              <span>Leer guía completa</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <BloqueFaq
    titulo="Preguntas frecuentes sobre reformas en Asturias"
    subtitulo="Resolvemos las dudas habituales antes de iniciar una reforma integral, baño, cocina o vivienda unifamiliar."
    faqs={FAQS_GENERALES}
  />

  <CtaSimulador />
</BaseLayout>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-service-tab]');
  const serviceCards = document.querySelectorAll<HTMLElement>('#services-cards-grid [data-service-cat]');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-service-tab') ?? 'todos';
      tabBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('on', active);
        b.setAttribute('aria-selected', String(active));
      });
      serviceCards.forEach((card) => {
        const cat = card.getAttribute('data-service-cat');
        card.hidden = targetCat !== 'todos' && cat !== targetCat;
      });
    });
  });
</script>
