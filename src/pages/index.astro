---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroQuickSelector from '../components/HeroQuickSelector.astro';
import BloqueFaq from '../components/BloqueFaq.astro';
import EquipoEEAT from '../components/EquipoEEAT.astro';
import {
  EMPRESA,
  FAQS_GENERALES,
  TESTIMONIOS_REALES,
  isPromoDuchaActive,
} from '../data/empresa';
import {
  buildOrganizationNode,
  buildWebSiteNode,
  buildFaqNode,
} from '../lib/schema';

import heroHomeImg from '../assets/images/servicios/hero-home-construcciones-mbl.webp';
import storyImg1 from '../assets/images/proyectos/obra-reforma-integral-1.webp';
import storyImg2 from '../assets/images/proyectos/obra-cocina-mbl-1.webp';
import storyImg3 from '../assets/images/proyectos/obra-bano-mbl-wide.webp';
import darkImg from '../assets/images/proyectos/proyecto-local-comercial-gijon-1.webp';
import galImg1 from '../assets/images/proyectos/obra-bano-mbl-14.webp';
import galImg2 from '../assets/images/proyectos/obra-cocina-mbl-2.webp';
import galImg3 from '../assets/images/proyectos/proyecto-alicatado-bano-1.webp';
import galImg4 from '../assets/images/proyectos/obra-ducha-mampara.webp';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const localidades = await getCollection('localidades');
const proyectosDestacados = (await getCollection('proyectos'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 2);
const ultimosArticulos = (await getCollection('blog'))
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished))
  .slice(0, 3);
const promos = await getCollection('promociones');
const promoDucha = promos.find((p) => p.data.id === 'plato-ducha-48h');
const showPromoDucha = isPromoDuchaActive(promoDucha?.data.activa ?? true);

const fasesMetodo = [
  {
    paso: 'Fase 01 · Diagnóstico en obra',
    titulo: 'Visita técnica gratuita en cualquier punto de Asturias',
    texto:
      'Nos desplazamos a tu vivienda o local en Gijón, Oviedo, Avilés o concejos cercanos para tomar medidas reales, revisar instalaciones y escuchar tus prioridades.',
  },
  {
    paso: 'Fase 02 · Transparencia total',
    titulo: 'Presupuesto cerrado y desglosado en 48 horas',
    texto:
      'Recibes cada capítulo detallado por partidas y materiales acordados. Sin conceptos genéricos ni desviaciones imprevistas durante la ejecución.',
  },
  {
    paso: 'Fase 03 · Ejecución coordinada',
    titulo: 'Dirección técnica propia y cumplimiento de plazos',
    texto:
      'Coordinamos todos los gremios (albañilería, fontanería, electricidad, carpintería y clima) con un único responsable asignado y seguimiento continuo.',
  },
  {
    paso: 'Fase 04 · Respaldo real',
    titulo: 'Entrega llave en mano con garantía por escrito',
    texto:
      'Revisamos contigo cada acabado antes de la entrega final y emitimos tu garantía por escrito: hasta 3 años en reformas y 10 años en construcción estructural.',
  },
];

const title = 'Reformas Integrales y Construcción en Asturias | MBL';
const description =
  'Empresa de reformas integrales, cocinas, baños y construcción en Asturias (Gijón, Oviedo y Avilés). Presupuesto cerrado en 48 h y garantía por escrito.';
const pageUrl = `${EMPRESA.dominio}/`;

const faqNode = buildFaqNode(FAQS_GENERALES, pageUrl);
const schemaGraph = [
  buildOrganizationNode(),
  buildWebSiteNode(),
  ...(faqNode ? [faqNode] : []),
];
---

<BaseLayout title={title} description={description} canonical={pageUrl} schemaGraph={schemaGraph}>
  <!-- ================= HERO ================= -->
  <header class="hero" id="inicio">
    <Image
      src={heroHomeImg}
      alt="Reforma integral de vivienda luminosa en Asturias ejecutada por Construcciones MBL"
      class="hero-bg"
      widths={[640, 1024, 1440]}
      sizes="(max-width: 1280px) 100vw, 1248px"
      loading="eager"
      fetchpriority="high"
    />

    <Header mode="overlay" currentPath="/" />

    <div class="hero-body">
      <div>
        <small>Gijón · Oviedo · Avilés · Todo el Principado de Asturias</small>
        <h1>Reformas Integrales y Construcción en Asturias</h1>
      </div>
      <div>
        <p class="lead">
          Transformamos viviendas, cocinas, baños y locales comerciales con presupuesto cerrado por partidas, dirección técnica diaria y cumplimiento estricto de plazos.
        </p>
        <p class="tag">+20 años · Presupuesto cerrado · Garantía escrita</p>
        <div class="hero-actions">
          <a class="pill pill-white" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
            Calcula tu presupuesto
          </a>
          <a class="pill" href={`tel:${EMPRESA.telefonoE164}`} data-track="tel">
            Llamar {EMPRESA.telefonoVisible}
          </a>
        </div>
      </div>
    </div>

    <HeroQuickSelector />
  </header>

  <!-- ================= NUESTRA HISTORIA + 4 MÉTRICAS ================= -->
  <section class="sec story" id="historia" aria-labelledby="historia-title">
    <div>
      <span class="sec-kicker">Construcciones MBL · Asturias</span>
      <h2 class="sec-title" id="historia-title">Nuestra Historia</h2>
      <p class="story-copy">
        En Construcciones MBL nacimos con un objetivo claro: eliminar la incertidumbre que suele acompañar a una obra. Combinamos más de dos décadas de oficio en Asturias con una planificación técnica rigurosa para que reformar tu piso o construir tu casa sea un proceso predecible, limpio y bien ejecutado.
      </p>
      <p class="story-copy">
        Desde nuestra oficina técnica en Cristasa (Gijón), gestionamos licencias municipales, aislamiento frente a la humedad atlántica y acabados duraderos con garantía escrita.
      </p>

      <div class="stats" aria-label="Cifras clave de Construcciones MBL">
        {EMPRESA.metricas.map((m) => (
          <div class="stat">
            <strong>{m.valor}</strong>
            <span>{m.etiqueta}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="imgs">
      <div class="photo-tile">
        <Image
          src={storyImg1}
          alt="Salón reformado integralmente en Asturias con carpintería blanca"
          widths={[400, 720]}
          sizes="(max-width: 900px) 50vw, 320px"
        />
      </div>
      <div class="photo-tile">
        <Image
          src={storyImg2}
          alt="Cocina moderna reformada a medida en Asturias"
          widths={[400, 720]}
          sizes="(max-width: 900px) 50vw, 320px"
        />
      </div>
      <div class="photo-tile">
        <Image
          src={storyImg3}
          alt="Baño contemporáneo reformado con plato de ducha en Asturias"
          widths={[600, 960]}
          sizes="(max-width: 900px) 100vw, 660px"
        />
      </div>
    </div>
  </section>

  <!-- ================= SERVICIOS EN ASTURIAS (TABS) ================= -->
  <section class="sec" id="servicios" style="padding-top:8px" aria-labelledby="servicios-title">
    <span class="sec-kicker">Especialidades llave en mano</span>
    <h2 class="sec-title" id="servicios-title">Nuestros Servicios en Asturias</h2>

    <div class="tabs" role="tablist" aria-label="Filtrar servicios por especialidad">
      <button type="button" class="tab on" role="tab" aria-selected="true" data-service-tab="todos">
        Todos los servicios
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="reformas">
        Reformas de vivienda
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="banos-cocinas">
        Baños y cocinas
      </button>
      <button type="button" class="tab" role="tab" aria-selected="false" data-service-tab="obra-locales">
        Vivienda nueva y locales
      </button>
    </div>

    <div class="cards" id="services-cards-grid">
      {servicios.map((srv) => (
        <article class="card" data-service-cat={srv.data.categoriaTab}>
          <Image
            src={srv.data.imagen}
            alt={srv.data.imagenAlt}
            class="card-img"
            widths={[440, 760]}
            sizes="(max-width: 900px) 100vw, 380px"
          />
          <span class="card-badge">⏱ {srv.data.plazoVisible}</span>
          <div class="txt">
            <h3>
              <a href={`/${srv.data.slug}/`}>{srv.data.tituloCorto}</a>
            </h3>
            <p>{srv.data.metaDescription}</p>
          </div>
          <a class="price" href={`/${srv.data.slug}/`}>
            {srv.data.precioDesde}
          </a>
        </article>
      ))}
    </div>

    {showPromoDucha && promoDucha && (
      <div class="promo-strip">
        <div>
          <span class="sec-kicker" style="color:var(--warm);margin-bottom:4px">
            Servicio Exprés 48 Horas · Disponible en toda Asturias
          </span>
          <h3>{promoDucha.data.titulo}</h3>
          <p>{promoDucha.data.subtitulo}</p>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <span class="pill" style="pointer-events:none">
            {promoDucha.data.precioDesde}
          </span>
          <a
            class="pill pill-white"
            href="/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/"
          >
            Ver servicio 48 h →
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- ================= BLOQUE OSCURO MÉTODO MBL (ASTURIAS) ================= -->
  <section class="dark" aria-labelledby="metodo-title">
    <div class="ghost" aria-hidden="true">{EMPRESA.marcasAgua.bloqueOscuro}</div>
    <div class="arrows">
      <button type="button" class="arr on" aria-label="Fase anterior" data-method-prev>↑</button>
      <button type="button" class="arr" aria-label="Fase siguiente" data-method-next>↓</button>
    </div>

    <div>
      <span class="sec-kicker" style="color:#cccccc">Método Construcciones MBL</span>
      <h2 id="metodo-title">Construimos con presupuesto cerrado y garantía escrita</h2>
      <p style="margin-top:16px">
        {EMPRESA.garantias.reformaIntegral} {EMPRESA.garantias.financiacion}
      </p>
    </div>

    <div>
      <div id="method-steps-container" aria-live="polite">
        {fasesMetodo.map((f, idx) => (
          <div class="method-step" data-method-idx={idx} hidden={idx !== 0}>
            <span class="sec-kicker" style="color:var(--warm)">{f.paso}</span>
            <h3>{f.titulo}</h3>
            <p>{f.texto}</p>
          </div>
        ))}
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:10px">
        <a class="pill pill-white" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
          Solicitar presupuesto cerrado
        </a>
        <a class="pill" href="/servicios/">Ver catálogo de servicios</a>
      </div>

      <div class="dark-img-wrap">
        <Image
          src={darkImg}
          alt="Equipo técnico de Construcciones MBL ejecutando obra con nivelación láser en Asturias"
          widths={[520, 900]}
          sizes="(max-width: 900px) 100vw, 560px"
        />
      </div>
    </div>
  </section>

  <!-- ================= PROYECTOS DESTACADOS + GALERÍA ================= -->
  <section class="sec two" aria-labelledby="proyectos-home-title">
    <div>
      <span class="sec-kicker">Obras reales ejecutadas</span>
      <h2 class="sec-title" id="proyectos-home-title">Proyectos Destacados</h2>
      <div class="choice">
        {proyectosDestacados.map((proy) => (
          <article class="card">
            <Image
              src={proy.data.imagen}
              alt={proy.data.imagenAlt}
              class="card-img"
              widths={[460, 780]}
              sizes="(max-width: 900px) 100vw, 440px"
            />
            <span class="card-badge">{proy.data.municipio} · {proy.data.superficieM2}</span>
            <div class="txt">
              <h3><a href="/proyectos/">{proy.data.titulo}</a></h3>
              <p>{proy.data.resumen}</p>
            </div>
          </article>
        ))}
        <div class="ctrl">
          <a class="btn-dark" href="/proyectos/">Ver todos los proyectos →</a>
        </div>
      </div>
    </div>

    <div>
      <span class="sec-kicker">Acabados e interiores</span>
      <h2 class="sec-title">Galería de Obras en Asturias</h2>
      <div class="gallery">
        <div class="photo-tile">
          <Image
            src={galImg1}
            alt="Reforma completa de baño moderno con ducha y mueble suspendido en Asturias"
            widths={[640, 1024]}
            sizes="(max-width: 900px) 100vw, 720px"
          />
        </div>
        <div class="photo-tile">
          <Image
            src={galImg2}
            alt="Cocina reformada con armarios a medida y acabado cálido en Asturias"
            widths={[360, 560]}
            sizes="(max-width: 900px) 50vw, 240px"
          />
        </div>
        <div class="photo-tile">
          <Image
            src={galImg3}
            alt="Alicatado porcelánico rectificado ejecutado por Construcciones MBL"
            widths={[360, 560]}
            sizes="(max-width: 900px) 50vw, 240px"
          />
        </div>
        <div class="photo-tile">
          <Image
            src={galImg4}
            alt="Cambio de bañera por plato de ducha antideslizante con mampara en Asturias"
            widths={[360, 560]}
            sizes="(max-width: 900px) 100vw, 240px"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ZONAS DE ACTUACIÓN EN ASTURIAS ================= -->
  <section class="sec" style="padding-top:8px" aria-labelledby="zonas-title">
    <span class="sec-kicker">Cobertura local sin sobrecoste de desplazamiento</span>
    <h2 class="sec-title" id="zonas-title">Reformas en Gijón, Oviedo y Avilés</h2>
    <div class="zonas-grid">
      {localidades.map((loc) => (
        <article class="zona-card">
          <div class="zona-card-img">
            <Image
              src={loc.data.imagen}
              alt={loc.data.imagenAlt}
              widths={[420, 720]}
              sizes="(max-width: 900px) 100vw, 380px"
            />
          </div>
          <div class="zona-card-body">
            <h3><a href={`/${loc.data.slug}/`}>Reformas en {loc.data.municipio}</a></h3>
            <p>{loc.data.subtituloHero}</p>
            <p style="font-size:12.5px;color:var(--muted);margin-top:auto">
              Trámites en {loc.data.ayuntamiento} · Visita técnica 48 h
            </p>
            <a class="btn-outline" href={`/${loc.data.slug}/`} style="margin-top:8px">
              Ver servicios en {loc.data.municipio} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= TESTIMONIOS REALES ================= -->
  <section class="sec testi" aria-labelledby="testi-title">
    <div class="testi-img">
      <Image
        src={storyImg1}
        alt="Resultado de vivienda reformada con opiniones verificadas de clientes en Asturias"
        widths={[540, 880]}
        sizes="(max-width: 900px) 100vw, 560px"
      />
    </div>

    <div>
      <span class="sec-kicker">
        ★ {EMPRESA.googleBusiness.ratingValor} / 5 · Basado en {EMPRESA.googleBusiness.totalResenas} reseñas verificadas en Google
      </span>
      <h2 class="sec-title" id="testi-title" style="margin-bottom:18px">
        Opiniones Reales en Asturias
      </h2>

      <div id="testi-slides" aria-live="polite">
        {TESTIMONIOS_REALES.map((t, idx) => (
          <blockquote class="testi-slide" data-testi-idx={idx} hidden={idx !== 0}>
            <h3>“{t.titulo}”</h3>
            <p class="testi-quote">{t.cita}</p>
            <footer class="who">
              <span class="who-avatar" aria-hidden="true">{t.autor.slice(0, 1)}</span>
              <div>
                <strong>{t.autor}</strong>
                <small>{t.tipoObra} · {t.municipio}</small>
              </div>
            </footer>
          </blockquote>
        ))}
      </div>

      <div class="ctrl">
        <button type="button" class="arr light" aria-label="Opinión anterior" data-testi-prev>↑</button>
        <button type="button" class="arr light on" aria-label="Opinión siguiente" data-testi-next>↓</button>
        <a
          class="btn-outline"
          href={EMPRESA.googleBusiness.hasMap}
          target="_blank"
          rel="noopener noreferrer"
          style="margin-left:8px"
        >
          Ver ficha en Google Maps →
        </a>
      </div>
    </div>
  </section>

  <!-- ================= EQUIPO E-E-A-T ================= -->
  <EquipoEEAT compact />

  <!-- ================= ÚLTIMAS GUÍAS DEL BLOG ================= -->
  <section class="sec" style="padding-top:16px" aria-labelledby="blog-home-title">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px;margin-bottom:24px">
      <div>
        <span class="sec-kicker">Innovación Sostenible · Guías técnicas 2026</span>
        <h2 class="sec-title" id="blog-home-title">Consejos, Precios y Normativa en Asturias</h2>
      </div>
      <a class="btn-outline" href="/innovacion-sostenible/">Ver las 23 guías técnicas →</a>
    </div>

    <div class="zonas-grid">
      {ultimosArticulos.map((post) => (
        <article class="zona-card">
          <div class="zona-card-img">
            <Image
              src={post.data.imagen}
              alt={post.data.imagenAlt}
              widths={[420, 720]}
              sizes="(max-width: 900px) 100vw, 380px"
            />
          </div>
          <div class="zona-card-body">
            <span class="sec-kicker" style="margin-bottom:0">{post.data.categoriaNombre}</span>
            <h3 style="font-family:var(--f-body);text-transform:none;font-size:18px;font-weight:600;line-height:1.35">
              <a href={`/${post.data.categoria}/${post.data.slug}/`}>{post.data.titulo}</a>
            </h3>
            <p>{post.data.metaDescription}</p>
            <a
              class="btn-outline"
              href={`/${post.data.categoria}/${post.data.slug}/`}
              style="margin-top:auto"
            >
              Leer guía completa →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= FAQS PORTADA ================= -->
  <BloqueFaq
    titulo="Preguntas Frecuentes sobre Reformas en Asturias"
    subtitulo="Resolvemos las dudas habituales antes de iniciar una reforma integral, baño, cocina o vivienda unifamiliar."
    faqs={FAQS_GENERALES}
  />
</BaseLayout>

<script>
  // 1. Filtrado accesible de tabs de servicios
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-service-tab]');
  const serviceCards = document.querySelectorAll<HTMLElement>('#services-cards-grid [data-service-cat]');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.getAttribute('data-service-tab') ?? 'todos';
      tabBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('on', active);
        b.setAttribute('aria-selected', String(active));
      });
      serviceCards.forEach((card) => {
        const cat = card.getAttribute('data-service-cat');
        card.hidden = targetCat !== 'todos' && cat !== targetCat;
      });
    });
  });

  // 2. Carrusel método MBL (.dark)
  const methodSteps = document.querySelectorAll<HTMLElement>('.method-step');
  let methodIdx = 0;
  function showMethod(nextIdx: number) {
    if (methodSteps.length === 0) return;
    methodIdx = (nextIdx + methodSteps.length) % methodSteps.length;
    methodSteps.forEach((el, i) => {
      el.hidden = i !== methodIdx;
    });
  }
  document.querySelector('[data-method-prev]')?.addEventListener('click', () => showMethod(methodIdx - 1));
  document.querySelector('[data-method-next]')?.addEventListener('click', () => showMethod(methodIdx + 1));

  // 3. Carrusel testimonios reales
  const testiSlides = document.querySelectorAll<HTMLElement>('.testi-slide');
  let testiIdx = 0;
  function showTesti(nextIdx: number) {
    if (testiSlides.length === 0) return;
    testiIdx = (nextIdx + testiSlides.length) % testiSlides.length;
    testiSlides.forEach((el, i) => {
      el.hidden = i !== testiIdx;
    });
  }
  document.querySelector('[data-testi-prev]')?.addEventListener('click', () => showTesti(testiIdx - 1));
  document.querySelector('[data-testi-next]')?.addEventListener('click', () => showTesti(testiIdx + 1));
</script>
