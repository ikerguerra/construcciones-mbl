---
export interface Props {
  caption: string;
  columnas: string[];
  filas: string[][];
}

const { caption, columnas, filas } = Astro.props;
---

<div class="tabla-wrap" data-cols={String(columnas.length)}>
  <table data-cols={String(columnas.length)}>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {columnas.map((col) => <th scope="col">{col}</th>)}
      </tr>
    </thead>
    <tbody>
      {filas.map((fila) => (
        <tr>
          {fila.map((celda, idx) =>
            idx === 0 ? (
              <th scope="row" data-label={columnas[idx] ?? ''}>
                {celda}
              </th>
            ) : (
              <td data-label={columnas[idx] ?? ''}>{celda}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
