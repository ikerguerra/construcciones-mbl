---
import { Image } from 'astro:assets';
import { EMPRESA } from '../data/empresa';
import footerImg from '../assets/images/proyectos/obra-reforma-integral-1.webp';
---

<footer class="foot" id="footer">
  <div class="foot-top-nav">
    <ul class="foot-nav-group">
      <li><a href="/contacto/">Contacto</a></li>
      <li><a href="/proyectos/">Proyectos</a></li>
      <li><a href="/innovacion-sostenible/">Guías</a></li>
      <li><a href="/reformas-en-gijon/">Gijón</a></li>
      <li><a href="/reformas-en-oviedo/">Oviedo</a></li>
      <li><a href="/reformas-en-aviles/">Avilés</a></li>
    </ul>

    <ul class="foot-nav-group">
      <li><a href="/servicios/">Nuestros Servicios</a></li>
      <li><a href="/reformas-integrales-en-asturias/">Reformas Integrales</a></li>
      <li><a href="/reformas-de-cocinas-en-asturias/">Cocinas</a></li>
      <li><a href="/reformas-de-banos-en-asturias/">Baños</a></li>
      <li><a href="/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/">Ducha 48 h</a></li>
      <li><a href="/construccion-de-viviendas-en-asturias/">Viviendas</a></li>
      <li><a href="/reforma-de-locales-comerciales-en-asturias/">Locales</a></li>
    </ul>
  </div>

  <div class="foot-main">
    <div>
      <h4>Ubicación y contacto</h4>
      <address>
        <strong>{EMPRESA.marca}</strong> · {EMPRESA.direccion.calle}<br />
        {EMPRESA.direccion.codigoPostal} {EMPRESA.direccion.localidad}, {EMPRESA.direccion.provincia}<br />
        Tel: <a href={`tel:${EMPRESA.telefonoE164}`} data-track="tel" style="text-decoration:underline">{EMPRESA.telefonoVisible}</a> ·{' '}
        <a href={`mailto:${EMPRESA.email}`} style="text-decoration:underline">{EMPRESA.email}</a><br />
        <span>{EMPRESA.horario.resumen}</span>
      </address>

      <div class="soc" aria-label="Perfiles oficiales de Construcciones MBL">
        <a
          href={EMPRESA.redes.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Construcciones MBL"
          title="Instagram"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={EMPRESA.redes.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook de Construcciones MBL"
          title="Facebook"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5Z" />
          </svg>
        </a>
        <a
          href={EMPRESA.googleBusiness.hasMap}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ficha de Google Maps de Construcciones MBL en Gijón"
          title="Google Maps"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s-6-5.33-6-10a6 6 0 1 1 12 0c0 4.67-6 10-6 10Z" />
            <circle cx="12" cy="11" r="2.2" />
          </svg>
        </a>
      </div>

      <a class="fsearch" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <span>Calcula el precio de tu reforma en Asturias...</span>
      </a>
    </div>

    <div class="foot-photo">
      <Image
        src={footerImg}
        alt="Reforma interior acabada en Asturias por Construcciones MBL"
        widths={[520, 880]}
        sizes="(max-width: 900px) 100vw, 560px"
        loading="lazy"
      />
    </div>
  </div>

  <div class="foot-bottom">
    <div class="big" aria-hidden="true">{EMPRESA.marcasAgua.footer}</div>
    <div class="legal">
      <span>© {new Date().getFullYear()} {EMPRESA.razonSocial} · {EMPRESA.marca} (Asturias)</span>
      <div class="legal-links">
        <a href="/aviso-legal/">Aviso Legal</a>
        <a href="/politica-de-privacidad/">Política de Privacidad</a>
        <a href="/politica-de-cookies/">Política de Cookies</a>
        <button type="button" data-open-cookies style="color:#cccccc">Configurar cookies</button>
      </div>
    </div>
  </div>
</footer>
