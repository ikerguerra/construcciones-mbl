---
import { AUTORES, EMPRESA } from '../data/empresa';

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const listaAutores = [AUTORES['borja-direccion'], AUTORES['equipo-tecnico']];
---

<section class={compact ? 'sec-compact' : 'sec'} aria-labelledby="equipo-heading">
  <span class="sec-kicker">Dirección de obra y solvencia técnica</span>
  <h2 class="sec-title" id="equipo-heading">Equipo responsable en Asturias</h2>
  <p class="story-copy" style="margin-bottom:0">
    Cada presupuesto cerrado y cada guía técnica publicada en Construcciones MBL cuenta con supervisión directa desde nuestra oficina en {EMPRESA.direccion.calle} ({EMPRESA.direccion.localidad}).
  </p>

  <div class="eeat-grid">
    {listaAutores.map((autor) => (
      <article class="eeat-card">
        <h3>{autor.nombre}</h3>
        <p class="eeat-role">{autor.rol}</p>
        <p style="font-size:14.5px;color:#333;margin-bottom:12px">{autor.bio}</p>
        <ul style="padding-left:18px;font-size:13.5px;color:#222;display:grid;gap:4px">
          {autor.especialidades.map((esp) => (
            <li>{esp}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
