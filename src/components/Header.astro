---
import logoFullLight from '../assets/brand/logo-mbl-full-light.svg';
import { EMPRESA } from '../data/empresa';

export interface Props {
  mode?: 'overlay' | 'solid';
  currentPath?: string;
}

const { mode = 'solid', currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const isServiciosActive =
  currentPath === '/servicios/' ||
  currentPath.startsWith('/reformas-') ||
  currentPath.startsWith('/reforma-') ||
  currentPath.startsWith('/construccion-') ||
  currentPath.startsWith('/cambio-de-banera');

const menuId = 'mobile-nav-drawer';

const serviciosSubmenu = [
  { href: '/reformas-integrales-en-asturias/', label: 'Reformas integrales' },
  { href: '/reformas-de-cocinas-en-asturias/', label: 'Reformas de cocinas' },
  { href: '/reformas-de-banos-en-asturias/', label: 'Reformas de baños' },
  {
    href: '/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/',
    label: 'Plato de ducha exprés 48 h',
  },
  { href: '/construccion-de-viviendas-en-asturias/', label: 'Construcción de viviendas' },
  { href: '/reformas-parciales-en-asturias/', label: 'Reformas parciales' },
  { href: '/reforma-de-locales-comerciales-en-asturias/', label: 'Locales comerciales' },
  { href: '/servicios/', label: 'Ver catálogo y tarifas →' },
];
---

<div class="nav-anchor" data-nav-anchor>
  <div class={`nav-wrap ${mode === 'solid' ? 'nav-solid-wrap' : 'nav-overlay-wrap'}`}>
    <nav class={`nav ${mode === 'solid' ? 'nav-solid' : ''}`} aria-label="Navegación principal">
      <div class="pills">
        <a class={`pill ${isActive('/') ? 'active' : ''}`} href="/">Inicio</a>

        <div class="nav-dropdown">
          <a
            class={`pill has-dropdown ${isServiciosActive ? 'active' : ''}`}
            href="/servicios/"
          >
            <span>Servicios</span>
            <svg
              class="nav-chev"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </a>
          <div class="nav-dropdown-menu" aria-label="Especialidades de Construcciones MBL">
            {serviciosSubmenu.map((item) => (
              <a
                href={item.href}
                class={currentPath === item.href ? 'is-current' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>

        <a class={`pill ${isActive('/proyectos/') ? 'active' : ''}`} href="/proyectos/">Proyectos</a>
      </div>

      <a class="logo-link" href="/" aria-label={`${EMPRESA.marca} — Ir a inicio`}>
        <img
          src={logoFullLight.src}
          alt={EMPRESA.marca}
          class="nav-logo-img"
          width="76"
          height="48"
        />
      </a>

      <div class="pills end">
        <a
          class={`pill ${isActive('/innovacion-sostenible/') ? 'active' : ''}`}
          href="/innovacion-sostenible/"
        >
          Guías
        </a>
        <a class={`pill ${isActive('/contacto/') ? 'active' : ''}`} href="/contacto/">Contacto</a>
        <a
          class="pill pill-white"
          href="/calcula-el-precio-de-tu-reforma-en-asturias/"
        >
          Calcula tu reforma
        </a>
      </div>

      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls={menuId}
        data-nav-toggle
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
        <span>Menú</span>
      </button>
    </nav>

    <div class="mobile-drawer" id={menuId} data-open="false" hidden>
      <a href="/">Inicio</a>
      <a href="/servicios/">Servicios (Catálogo completo)</a>
      <div class="mobile-drawer-sub">
        <a href="/reformas-integrales-en-asturias/">· Reformas integrales</a>
        <a href="/reformas-de-cocinas-en-asturias/">· Reformas de cocinas</a>
        <a href="/reformas-de-banos-en-asturias/">· Reformas de baños</a>
        <a href="/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/">· Plato de ducha 48 h</a>
        <a href="/construccion-de-viviendas-en-asturias/">· Construcción de viviendas</a>
        <a href="/reformas-parciales-en-asturias/">· Reformas parciales</a>
        <a href="/reforma-de-locales-comerciales-en-asturias/">· Locales comerciales</a>
      </div>
      <a href="/proyectos/">Proyectos realizados</a>
      <a href="/reformas-en-gijon/">Reformas en Gijón</a>
      <a href="/reformas-en-oviedo/">Reformas en Oviedo</a>
      <a href="/reformas-en-aviles/">Reformas en Avilés</a>
      <a href="/innovacion-sostenible/">Innovación Sostenible (Guías)</a>
      <a href="/contacto/">Contacto</a>
      <a href="/calcula-el-precio-de-tu-reforma-en-asturias/">Calcula el precio de tu reforma</a>
      <a href={`tel:${EMPRESA.telefonoE164}`} data-track="tel">Llamar: {EMPRESA.telefonoVisible}</a>
    </div>
  </div>
</div>

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    const closeDrawer = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('data-open', 'false');
      drawer.hidden = true;
    };

    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      drawer.setAttribute('data-open', String(!expanded));
      drawer.hidden = expanded;
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !drawer.hidden) {
        closeDrawer();
        toggleBtn.focus();
      }
    });
  }

  // Barra de navegación fija con aparición fluida tras superar el Hero
  const navAnchor = document.querySelector<HTMLElement>('[data-nav-anchor]');
  const navWrap = navAnchor?.querySelector<HTMLElement>('.nav-wrap');
  const heroEl = document.querySelector<HTMLElement>('.hero');

  if (navAnchor && navWrap) {
    let cachedHeight = navWrap.offsetHeight;

    const updateStickyNav = () => {
      if (!navWrap.classList.contains('is-sticky')) {
        cachedHeight = navWrap.offsetHeight;
      }
      const threshold = heroEl ? heroEl.offsetTop + heroEl.offsetHeight - 60 : 200;
      const shouldStick = window.scrollY > threshold;
      if (shouldStick) {
        if (!navWrap.classList.contains('is-sticky')) {
          navAnchor.style.minHeight = `${cachedHeight}px`;
          navWrap.classList.add('is-sticky');
        }
      } else if (navWrap.classList.contains('is-sticky')) {
        navWrap.classList.remove('is-sticky');
        navAnchor.style.minHeight = '';
      }
    };

    window.addEventListener('scroll', updateStickyNav, { passive: true });
    window.addEventListener('resize', updateStickyNav, { passive: true });
    updateStickyNav();
  }
</script>
