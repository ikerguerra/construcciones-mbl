---
import logoFullLight from '../assets/brand/logo-mbl-full-light.svg';
import { EMPRESA } from '../data/empresa';

export interface Props {
  mode?: 'overlay' | 'solid';
  currentPath?: string;
}

const { mode = 'solid', currentPath = Astro.url.pathname } = Astro.props;
const Wrapper = mode === 'solid' ? 'header' : Fragment;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const isServiciosActive =
  currentPath === '/servicios/' ||
  currentPath.startsWith('/reformas-') ||
  currentPath.startsWith('/reforma-') ||
  currentPath.startsWith('/construccion-') ||
  currentPath.startsWith('/cambio-de-banera');

const isHerramientasActive =
  currentPath.startsWith('/calcula') ||
  currentPath.startsWith('/licencia-obra-asturias') ||
  currentPath.startsWith('/comparador-aerotermia');

const menuId = 'mobile-nav-drawer';

const herramientasSubmenu = [
  {
    href: '/calcula-el-precio-de-tu-reforma-en-asturias/',
    label: 'Calculadora de presupuesto (Rápida + PEM/ICIO)',
  },
  { href: '/licencia-obra-asturias/', label: 'Simulador de licencias e ICIO (18 concejos)' },
  { href: '/calculadora-deducciones-irpf-reforma/', label: 'Calculadora de deducciones IRPF' },
  { href: '/comparador-aerotermia-asturias/', label: 'Comparador de aerotermia vs caldera' },
];

const serviciosSubmenu = [
  { href: '/reformas-integrales-en-asturias/', label: 'Reformas integrales' },
  { href: '/reformas-de-cocinas-en-asturias/', label: 'Reformas de cocinas' },
  { href: '/reformas-de-banos-en-asturias/', label: 'Reformas de baños' },
  {
    href: '/cambio-de-banera-por-plato-de-ducha-en-asturias-oferta-expres-48-horas/',
    label: 'Plato de ducha exprés 48 h',
  },
  { href: '/rehabilitacion-de-fachadas-y-tejados-en-asturias/', label: 'Fachadas, SATE y tejados' },
  { href: '/rehabilitacion-de-casas-de-pueblo-en-asturias/', label: 'Casas de pueblo y piedra' },
  { href: '/construccion-de-viviendas-en-asturias/', label: 'Construcción de viviendas' },
  { href: '/reformas-parciales-en-asturias/', label: 'Reformas parciales' },
  { href: '/reforma-de-locales-comerciales-en-asturias/', label: 'Locales comerciales' },
  { href: '/servicios/', label: 'Ver catálogo y tarifas →' },
];

const zonasSubmenu = [
  { href: '/reformas-en-gijon/', label: 'Gijón' },
  { href: '/reformas-en-oviedo/', label: 'Oviedo' },
  { href: '/reformas-en-aviles/', label: 'Avilés' },
  { href: '/reformas-en-siero/', label: 'Siero' },
  { href: '/reformas-en-villaviciosa/', label: 'Villaviciosa' },
  { href: '/reformas-en-llanera/', label: 'Llanera' },
];
---

<Wrapper>
<div class="nav-anchor" data-nav-anchor>
  <div class={`nav-wrap ${mode === 'solid' ? 'nav-solid-wrap' : 'nav-overlay-wrap'}`}>
    <nav class={`nav ${mode === 'solid' ? 'nav-solid' : ''}`} aria-label="Navegación principal">
      <div class="pills">
        <a class={`pill ${isActive('/') ? 'active' : ''}`} href="/">Inicio</a>

        <div class="nav-dropdown">
          <a
            class={`pill has-dropdown ${isServiciosActive ? 'active' : ''}`}
            href="/servicios/"
          >
            <span>Servicios</span>
            <svg
              class="nav-chev"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </a>
          <div class="nav-dropdown-menu" aria-label="Especialidades de Construcciones MBL">
            {serviciosSubmenu.map((item) => (
              <a
                href={item.href}
                class={currentPath === item.href ? 'is-current' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>

        <a class={`pill ${isActive('/proyectos/') ? 'active' : ''}`} href="/proyectos/">Proyectos</a>
        <a class={`pill ${isActive('/empresa/') ? 'active' : ''}`} href="/empresa/">Empresa</a>
      </div>

      <a class="logo-link" href="/" aria-label={`${EMPRESA.marca} — Ir a inicio`}>
        <img
          src={logoFullLight.src}
          alt={EMPRESA.marca}
          class="nav-logo-img"
          width="76"
          height="48"
        />
      </a>

      <div class="pills end">
        <div class="nav-dropdown">
          <a
            class={`pill has-dropdown ${isHerramientasActive ? 'active' : ''}`}
            href="/calcula-el-precio-de-tu-reforma-en-asturias/"
          >
            <span>Calculadoras</span>
            <svg
              class="nav-chev"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </a>
          <div class="nav-dropdown-menu" aria-label="Calculadoras de reformas y licencias en Asturias">
            {herramientasSubmenu.map((item) => (
              <a
                href={item.href}
                class={currentPath === item.href ? 'is-current' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>

        <a
          class={`pill ${isActive('/innovacion-sostenible/') ? 'active' : ''}`}
          href="/innovacion-sostenible/"
        >
          Guías
        </a>
        <a class={`pill ${isActive('/contacto/') ? 'active' : ''}`} href="/contacto/">Contacto</a>
        <a
          class="pill pill-white"
          href="/calcula-el-precio-de-tu-reforma-en-asturias/"
        >
          Pedir presupuesto
        </a>
      </div>

      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls={menuId}
        data-nav-toggle
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
        <span>Menú</span>
      </button>
    </nav>
  </div>
</div>

<div
  class="mobile-drawer"
  id={menuId}
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  hidden
>
  <div class="mob-drawer-backdrop" data-nav-backdrop></div>
  <div class="mob-drawer-panel">
    <div class="mob-drawer-head">
      <a class="mob-drawer-logo" href="/" aria-label={`${EMPRESA.marca} — Ir a inicio`}>
        <img
          src={logoFullLight.src}
          alt={EMPRESA.marca}
          width="76"
          height="48"
        />
      </a>
      <button
        type="button"
        class="mob-drawer-close"
        aria-label="Cerrar menú"
        data-nav-close
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <div class="mob-drawer-body">
      <nav class="mob-nav-links" aria-label="Navegación móvil">
        <a class={`mob-nav-link ${isActive('/') ? 'is-current' : ''}`} href="/">Inicio</a>
        <a class={`mob-nav-link ${isActive('/proyectos/') ? 'is-current' : ''}`} href="/proyectos/">Proyectos realizados</a>
        <a class={`mob-nav-link ${isActive('/empresa/') ? 'is-current' : ''}`} href="/empresa/">Empresa</a>
        <a class={`mob-nav-link ${isActive('/innovacion-sostenible/') ? 'is-current' : ''}`} href="/innovacion-sostenible/">Guías e Innovación</a>
        <a class={`mob-nav-link ${isActive('/contacto/') ? 'is-current' : ''}`} href="/contacto/">Contacto</a>
      </nav>

      <details class="mob-acc" open={isServiciosActive ? true : undefined}>
        <summary>
          <span>Servicios y Reformas</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="mob-acc-list">
          {serviciosSubmenu.map((item) => (
            <a
              href={item.href}
              class={currentPath === item.href ? 'is-current' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <details class="mob-acc" open={isHerramientasActive ? true : undefined}>
        <summary>
          <span>Calculadoras Gratuitas</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="mob-acc-list">
          {herramientasSubmenu.map((item) => (
            <a
              href={item.href}
              class={currentPath === item.href ? 'is-current' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <details class="mob-acc">
        <summary>
          <span>Zonas en Asturias</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="mob-zone-grid">
          {zonasSubmenu.map((z) => (
            <a
              href={z.href}
              class={currentPath === z.href ? 'is-current' : undefined}
            >
              {z.label}
            </a>
          ))}
        </div>
      </details>
    </div>

    <div class="mob-drawer-foot">
      <a
        class="pill pill-white mob-drawer-cta"
        href="/calcula-el-precio-de-tu-reforma-en-asturias/"
      >
        Calcular presupuesto →
      </a>
      <div class="mob-drawer-quick">
        <a class="mob-quick-btn" href={`tel:${EMPRESA.telefonoE164}`} data-track="tel">
          Llamar · {EMPRESA.telefonoVisible}
        </a>
        <a
          class="mob-quick-btn mob-quick-wa"
          href={EMPRESA.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="wa"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>
</Wrapper>
