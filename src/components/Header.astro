---
import logoMark from '../assets/brand/logo-mbl-mark.svg';
import { EMPRESA } from '../data/empresa';
import Icon from './Icon.astro';

export interface Props {
  mode?: 'overlay' | 'solid';
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const menuId = 'mobile-nav-drawer';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios/', label: 'Servicios' },
  { href: '/proyectos/', label: 'Proyectos' },
  { href: '/innovacion-sostenible/', label: 'Guías' },
  { href: '/contacto/', label: 'Contacto' },
];
---

<header class="site-header">
  <nav class="nav" aria-label="Navegación principal">
    <a class="logo-link" href="/" aria-label={`${EMPRESA.marca} — Ir a inicio`}>
      <img src={logoMark.src} alt="" width="34" height="24" aria-hidden="true" />
      <span class="logo-text">Construcciones MBL</span>
    </a>

    <ul class="nav-links">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            class={isActive(item.href) ? 'is-active' : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <a class="nav-tel" href={`tel:${EMPRESA.telefonoE164}`} data-track="tel">
        <Icon name="phone" size={16} />
        <span>{EMPRESA.telefonoVisible}</span>
      </a>
      <a class="btn-primary btn-sm" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
        <Icon name="calculator" size={16} />
        <span>Calcula tu reforma</span>
      </a>
    </div>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls={menuId}
      data-nav-toggle
    >
      <Icon name="menu" size={20} />
      <span>Menú</span>
    </button>
  </nav>

  <div class="mobile-drawer" id={menuId} data-open="false" hidden>
    <a href="/">Inicio</a>
    <a href="/servicios/">Servicios</a>
    <a href="/proyectos/">Proyectos</a>
    <a href="/reformas-en-gijon/">Reformas en Gijón</a>
    <a href="/reformas-en-oviedo/">Reformas en Oviedo</a>
    <a href="/reformas-en-aviles/">Reformas en Avilés</a>
    <a href="/innovacion-sostenible/">Innovación Sostenible (Guías)</a>
    <a href="/contacto/">Contacto</a>
    <a class="mobile-drawer-cta" href="/calcula-el-precio-de-tu-reforma-en-asturias/">
      <Icon name="calculator" size={16} />
      <span>Calcula el precio de tu reforma</span>
    </a>
    <a href={`tel:${EMPRESA.telefonoE164}`} data-track="tel">
      <Icon name="phone" size={16} />
      <span>Llamar: {EMPRESA.telefonoVisible}</span>
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggleBtn && drawer) {
    const closeDrawer = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('data-open', 'false');
      drawer.hidden = true;
    };

    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      drawer.setAttribute('data-open', String(!expanded));
      drawer.hidden = expanded;
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !drawer.hidden) {
        closeDrawer();
        toggleBtn.focus();
      }
    });
  }
</script>
