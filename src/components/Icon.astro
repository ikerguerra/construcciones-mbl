---
import type { IconName } from '../lib/icons';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
---

<svg
  class={`lucide lucide-${name}${className ? ` ${className}` : ''}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <use href={`#i-${name}`} />
</svg>
