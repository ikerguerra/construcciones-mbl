---
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? '';
---

<div
  id="mbl-cookie-banner"
  class="cookie-banner"
  role="region"
  aria-labelledby="cookie-title"
  hidden
>
  <div class="cookie-banner-copy">
    <h2 id="cookie-title" style="font-family:var(--f-body);text-transform:none;font-size:16px;font-weight:600;margin-bottom:4px">
      Tu privacidad en Construcciones MBL
    </h2>
    <p style="font-size:13px;color:#d4d4d4;line-height:1.45">
      Usamos cookies técnicas necesarias y, solo si aceptas, medición anónima para mejorar nuestros contenidos y simulador en Asturias. Puedes aceptar, rechazar o revisar la{' '}
      <a href="/politica-de-cookies/" style="color:#fff;text-decoration:underline">Política de Cookies</a>.
    </p>
  </div>

  <div class="cookie-actions">
    <button type="button" class="pill pill-white" id="cookie-accept-all">Aceptar todas</button>
    <button type="button" class="pill" id="cookie-reject-all">Rechazar opcionales</button>
    <button type="button" class="pill" id="cookie-toggle-prefs" aria-expanded="false" aria-controls="cookie-prefs-panel">Configurar</button>
    <button type="button" class="pill pill-white" id="cookie-save-prefs" hidden>Guardar selección</button>
  </div>

  <div id="cookie-prefs-panel" hidden class="cookie-prefs-panel">
    <label style="display:flex;gap:8px;align-items:center">
      <input type="checkbox" checked disabled />
      <span>Cookies técnicas necesarias (siempre activas)</span>
    </label>
    <label style="display:flex;gap:8px;align-items:center;cursor:pointer">
      <input type="checkbox" id="cookie-opt-analytics" />
      <span>Medición y analítica web propia (Google Analytics / Consent Mode v2)</span>
    </label>
  </div>
</div>

<script is:inline define:vars={{ gtmId, ga4Id }}>
  (function () {
    var STORAGE_KEY = 'mbl_consent_v1';
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;

    // Estado inicial Consent Mode v2 por defecto denegado (RGPD / AEPD)
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500,
    });

    var analyticsLoaded = false;

    function loadOwnAnalytics() {
      if (analyticsLoaded) return;
      analyticsLoaded = true;

      if (gtmId) {
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var gtmScript = document.createElement('script');
        gtmScript.async = true;
        gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
        document.head.appendChild(gtmScript);
      }

      if (ga4Id && !gtmId) {
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4Id);
        document.head.appendChild(gaScript);
        gtag('js', new Date());
        gtag('config', ga4Id, { anonymize_ip: true });
      }
    }

    function applyConsent(analyticsGranted, persist) {
      gtag('consent', 'update', {
        analytics_storage: analyticsGranted ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      if (analyticsGranted) {
        loadOwnAnalytics();
      }

      if (persist) {
        try {
          localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({ analytics: analyticsGranted, updatedAt: new Date().toISOString() })
          );
        } catch (_e) {}
      }
    }

    var banner = document.getElementById('mbl-cookie-banner');
    var prefsPanel = document.getElementById('cookie-prefs-panel');
    var optAnalytics = document.getElementById('cookie-opt-analytics');
    var saveBtn = document.getElementById('cookie-save-prefs');
    var configBtn = document.getElementById('cookie-toggle-prefs');

    function showBanner() {
      if (!banner) return;
      banner.hidden = false;
      document.documentElement.classList.add('has-cookie-banner');
    }

    function hideBanner() {
      if (!banner) return;
      banner.hidden = true;
      document.documentElement.classList.remove('has-cookie-banner');
    }

    try {
      var saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        var parsed = JSON.parse(saved);
        if (optAnalytics) optAnalytics.checked = Boolean(parsed.analytics);
        applyConsent(Boolean(parsed.analytics), false);
      } else {
        showBanner();
      }
    } catch (_e) {
      showBanner();
    }

    document.getElementById('cookie-accept-all')?.addEventListener('click', function () {
      applyConsent(true, true);
      hideBanner();
    });

    document.getElementById('cookie-reject-all')?.addEventListener('click', function () {
      applyConsent(false, true);
      hideBanner();
    });

    configBtn?.addEventListener('click', function () {
      if (prefsPanel && saveBtn) {
        var willShow = prefsPanel.hidden;
        prefsPanel.hidden = !willShow;
        saveBtn.hidden = !willShow;
        configBtn.setAttribute('aria-expanded', String(willShow));
      }
    });

    saveBtn?.addEventListener('click', function () {
      var granted = Boolean(optAnalytics && optAnalytics.checked);
      applyConsent(granted, true);
      hideBanner();
    });

    document.querySelectorAll('[data-open-cookies]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        showBanner();
      });
    });

    // Eventos limpios de conversión para teléfono y WhatsApp
    document.addEventListener('click', function (ev) {
      var el = ev.target && ev.target.closest ? ev.target.closest('[data-track]') : null;
      if (!el) return;
      var kind = el.getAttribute('data-track');
      if (kind === 'tel') {
        window.dataLayer.push({ event: 'click_telefono' });
      } else if (kind === 'wa') {
        window.dataLayer.push({ event: 'click_whatsapp' });
      }
    });
  })();
</script>
