---
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? '';
---

<div
  id="mbl-cookie-banner"
  class="cookie-banner"
  role="region"
  aria-labelledby="cookie-title"
  tabindex="-1"
  hidden
>
  <div class="cookie-banner-copy">
    <h2 id="cookie-title" style="font-family:var(--f-body);text-transform:none;font-size:16px;font-weight:600;margin-bottom:4px">
      Tu privacidad en Construcciones MBL
    </h2>
    <p style="font-size:13px;color:#d4d4d4;line-height:1.45">
      Construcciones MBL utiliza cookies propias técnicas y, solo si las aceptas, analíticas de terceros (Google) para medición estadística anónima. Puedes aceptar, rechazar o revisar la{' '}
      <a href="/politica-de-cookies/" style="color:#fff;text-decoration:underline">Política de Cookies</a>.
    </p>
  </div>

  <div class="cookie-actions">
    <button type="button" class="pill cookie-btn-equal" id="cookie-accept-all">Aceptar todas</button>
    <button type="button" class="pill cookie-btn-equal" id="cookie-reject-all">Rechazar todas</button>
    <button type="button" class="pill cookie-btn-config" id="cookie-toggle-prefs" aria-expanded="false" aria-controls="cookie-prefs-panel">Configurar</button>
    <button type="button" class="pill cookie-btn-equal" id="cookie-save-prefs" hidden>Guardar selección</button>
  </div>

  <div id="cookie-prefs-panel" hidden class="cookie-prefs-panel">
    <label style="display:flex;gap:8px;align-items:center">
      <input type="checkbox" checked disabled />
      <span>Cookies técnicas necesarias (siempre activas)</span>
    </label>
    <label style="display:flex;gap:8px;align-items:center;cursor:pointer">
      <input type="checkbox" id="cookie-opt-analytics" />
      <span>Medición y analítica web de terceros (Google Analytics / Consent Mode v2)</span>
    </label>
  </div>
</div>

<script is:inline define:vars={{ gtmId, ga4Id }}>
  window.__MBL_ANALYTICS_CFG__ = { gtmId: gtmId, ga4Id: ga4Id };
</script>
<script is:inline defer src="/js/cookie-consent.js"></script>
