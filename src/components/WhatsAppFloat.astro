---
import { EMPRESA } from '../data/empresa';
import Icon from './Icon.astro';
---

<a
  class="wa-float"
  href={EMPRESA.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track="wa"
  aria-label="Contactar por WhatsApp con Construcciones MBL"
>
  <Icon name="message-circle" size={18} />
  <span>WhatsApp {EMPRESA.telefonoVisible}</span>
</a>
