---
import { EMPRESA } from '../data/empresa';
---

<a
  class="wa-float"
  href={EMPRESA.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track="wa"
  data-wa-float
  aria-label={`Contactar por WhatsApp con Construcciones MBL al ${EMPRESA.telefonoVisible}`}
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.03 2a9.94 9.94 0 0 0-8.57 14.95L2 22l5.21-1.37A9.95 9.95 0 1 0 12.03 2Zm5.78 14.12c-.24.68-1.42 1.3-1.97 1.37-.52.08-1.18.11-1.9-.12-.44-.14-1-.32-1.72-.63-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.05-2.52.28-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.52.24.6.83 2.09.9 2.24.08.15.13.33.03.53-.1.2-.15.33-.3.51-.15.17-.32.39-.45.52-.15.15-.31.32-.13.63.17.3.78 1.29 1.68 2.09 1.15 1.03 2.13 1.35 2.43 1.5.3.15.48.13.66-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.12.07.72-.17 1.4Z" />
  </svg>
  <span class="wa-float-label">{EMPRESA.telefonoVisible}</span>
</a>

<script>
  const waBtn = document.querySelector<HTMLElement>('[data-wa-float]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (waBtn && !prefersReduced) {
    const triggerExpand = () => {
      waBtn.classList.add('is-expanded');
      window.setTimeout(() => {
        waBtn.classList.remove('is-expanded');
      }, 3600);
    };
    window.setTimeout(triggerExpand, 2500);
    window.setInterval(triggerExpand, 9500);
  }
</script>
