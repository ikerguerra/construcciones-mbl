---
import { CALIDADES, TARIFAS, ZONAS_ASTURIAS, type TipoObraKey } from '../data/tarifas';

const tipos: TipoObraKey[] = [
  'reforma-integral',
  'reforma-cocina',
  'reforma-bano',
  'plato-ducha',
  'construccion-vivienda',
  'local-comercial',
  'reforma-parcial',
];
---

<form
  class="search"
  action="/calcula-el-precio-de-tu-reforma-en-asturias/"
  method="get"
  aria-label="Selector rápido para calcular tu reforma en Asturias"
>
  <div class="field">
    <label for="hero-tipo">Tipo de obra</label>
    <select id="hero-tipo" name="tipo">
      {tipos.map((k) => (
        <option value={k}>{TARIFAS[k].nombreCorto}</option>
      ))}
    </select>
  </div>

  <div class="field">
    <label for="hero-zona">Zona en Asturias</label>
    <select id="hero-zona" name="zona">
      {ZONAS_ASTURIAS.map((zona) => (
        <option value={zona}>{zona}</option>
      ))}
    </select>
  </div>

  <div class="field">
    <label for="hero-m2">Superficie aprox. (m²)</label>
    <input
      id="hero-m2"
      name="m2"
      type="number"
      min="1"
      max="450"
      value="85"
      inputmode="numeric"
    />
  </div>

  <div class="field">
    <label for="hero-calidad">Nivel de calidades</label>
    <select id="hero-calidad" name="calidad">
      {Object.values(CALIDADES).map((cal) => (
        <option value={cal.key} selected={cal.key === 'estandar'}>
          {cal.label}
        </option>
      ))}
    </select>
  </div>

  <button type="submit" class="go">Calcular →</button>
</form>

<script>
  const tipoSelect = document.getElementById('hero-tipo') as HTMLSelectElement | null;
  const m2Input = document.getElementById('hero-m2') as HTMLInputElement | null;
  const defaults: Record<string, { val: string; label: string }> = {
    'reforma-integral': { val: '85', label: 'Superficie aprox. (m²)' },
    'reforma-cocina': { val: '10', label: 'Superficie cocina (m²)' },
    'reforma-bano': { val: '5', label: 'Superficie baño (m²)' },
    'plato-ducha': { val: '1', label: 'N.º de baños (ud.)' },
    'construccion-vivienda': { val: '140', label: 'Superficie vivienda (m²)' },
    'local-comercial': { val: '80', label: 'Superficie local (m²)' },
    'reforma-parcial': { val: '40', label: 'Superficie actuación (m²)' },
  };
  const m2Label = document.querySelector<HTMLLabelElement>('label[for="hero-m2"]');

  tipoSelect?.addEventListener('change', () => {
    const cfg = defaults[tipoSelect.value];
    if (cfg && m2Input && m2Label) {
      m2Input.value = cfg.val;
      m2Label.textContent = cfg.label;
    }
  });
</script>
