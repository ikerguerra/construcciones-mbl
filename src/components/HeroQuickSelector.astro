---
import {
  CALIDADES,
  TARIFAS,
  ZONAS_ASTURIAS,
  type TipoObraKey,
} from "../data/tarifas";

const tipos: TipoObraKey[] = [
  "reforma-integral",
  "reforma-cocina",
  "reforma-bano",
  "plato-ducha",
  "construccion-vivienda",
  "local-comercial",
  "reforma-parcial",
];

const calidadesList = Object.values(CALIDADES);
---

<form
  class="search"
  action="/calcula-el-precio-de-tu-reforma-en-asturias/"
  method="get"
  aria-label="Selector rápido para calcular tu reforma en Asturias"
>
  <div class="field field-select" data-hero-dd>
    <input type="hidden" id="hero-tipo" name="tipo" value="reforma-integral" />
    <span class="field-label" id="hero-tipo-l">Tipo de obra</span>
    <button
      type="button"
      class="hero-select-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-labelledby="hero-tipo-l hero-tipo-v"
    >
      <span id="hero-tipo-v" data-hd>{TARIFAS["reforma-integral"].nombreCorto}</span>
      <span class="hero-select-chev" aria-hidden="true"></span>
    </button>
    <ul class="hero-select-menu" role="listbox" aria-labelledby="hero-tipo-l" hidden>
      {tipos.map((k) => (
        <li role="option" data-v={k} aria-selected={k === "reforma-integral" ? "true" : undefined}>
          {TARIFAS[k].nombreCorto}
        </li>
      ))}
    </ul>
  </div>

  <div class="field field-select" data-hero-dd>
    <input type="hidden" id="hero-zona" name="zona" value={ZONAS_ASTURIAS[0]} />
    <span class="field-label" id="hero-zona-l">Zona en Asturias</span>
    <button
      type="button"
      class="hero-select-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-labelledby="hero-zona-l hero-zona-v"
    >
      <span id="hero-zona-v" data-hd>{ZONAS_ASTURIAS[0]}</span>
      <span class="hero-select-chev" aria-hidden="true"></span>
    </button>
    <ul class="hero-select-menu" role="listbox" aria-labelledby="hero-zona-l" hidden>
      {ZONAS_ASTURIAS.map((zona, idx) => (
        <li role="option" data-v={zona} aria-selected={idx === 0 ? "true" : undefined}>
          {zona}
        </li>
      ))}
    </ul>
  </div>

  <div class="field field-number" data-hero-num>
    <label for="hero-m2">Superficie aprox. (m²)</label>
    <input
      id="hero-m2"
      name="m2"
      type="number"
      min="1"
      max="450"
      value="85"
      inputmode="numeric"
    />
  </div>

  <div class="field field-select" data-hero-dd>
    <input type="hidden" id="hero-calidad" name="calidad" value="estandar" />
    <span class="field-label" id="hero-calidad-l">Nivel de calidades</span>
    <button
      type="button"
      class="hero-select-trigger"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-labelledby="hero-calidad-l hero-calidad-v"
    >
      <span id="hero-calidad-v" data-hd>{CALIDADES.estandar.label}</span>
      <span class="hero-select-chev" aria-hidden="true"></span>
    </button>
    <ul class="hero-select-menu" role="listbox" aria-labelledby="hero-calidad-l" hidden>
      {calidadesList.map((cal) => (
        <li role="option" data-v={cal.key} aria-selected={cal.key === "estandar" ? "true" : undefined}>
          {cal.label}
        </li>
      ))}
    </ul>
  </div>

  <button
    type="submit"
    class="go"
    aria-label="Calcular presupuesto en el simulador"
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
    <span class="go-mobile-label">Calcular presupuesto</span>
  </button>
</form>

<script is:inline defer src="/js/hero-selector.js"></script>
