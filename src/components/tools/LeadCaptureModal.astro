---
import { EMPRESA } from '../../data/empresa';
---

<dialog
  id="mbl-lead-modal"
  class="m-auto w-[min(560px,94vw)] rounded-3xl border border-[#c6d9cb] bg-white p-0 text-[#111a14] shadow-2xl backdrop:bg-[#0f1d14]/70"
  aria-labelledby="lead-modal-title"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <span class="block text-xs font-semibold tracking-wider text-[#3e6b47] uppercase">
          Informe técnico personalizado
        </span>
        <h3 id="lead-modal-title" class="mt-1 text-xl font-bold text-[#111a14]">
          Descargar presupuesto en PDF + Checklist
        </h3>
      </div>
      <button
        type="button"
        data-close-lead-modal
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#d6ddd8] text-[#516158] hover:bg-[#eef3ee] hover:text-[#111a14]"
        aria-label="Cerrar ventana"
      >
        ✕
      </button>
    </div>

    <p id="lead-modal-summary" class="mt-3 rounded-2xl border border-[#c6d9cb] bg-[#f3f7f4] p-3.5 text-sm text-[#111a14]">
      Resumen preparado para envío y descarga inmediata.
    </p>

    <form id="mbl-lead-modal-form" class="mt-5 space-y-3.5" novalidate>
      <div class="hp-field" aria-hidden="true">
        <label for="modal-hp">No rellenar</label>
        <input id="modal-hp" name="empresa_web" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="modal-nombre" class="mb-1 block text-xs font-semibold text-[#111a14]">
            Nombre y apellidos *
          </label>
          <input
            id="modal-nombre"
            name="nombre"
            type="text"
            required
            minlength="2"
            placeholder="Tu nombre"
            class="w-full rounded-xl border border-[#d6ddd8] bg-white px-3.5 py-2.5 text-sm text-[#111a14] focus:border-[#164624] focus:outline-none"
          />
        </div>
        <div>
          <label for="modal-telefono" class="mb-1 block text-xs font-semibold text-[#111a14]">
            Teléfono / WhatsApp *
          </label>
          <input
            id="modal-telefono"
            name="telefono"
            type="tel"
            required
            minlength="9"
            placeholder="684 675 898"
            class="w-full rounded-xl border border-[#d6ddd8] bg-white px-3.5 py-2.5 text-sm text-[#111a14] focus:border-[#164624] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="modal-email" class="mb-1 block text-xs font-semibold text-[#111a14]">
          Correo electrónico *
        </label>
        <input
          id="modal-email"
          name="email"
          type="email"
          required
          placeholder="tu@correo.es"
          class="w-full rounded-xl border border-[#d6ddd8] bg-white px-3.5 py-2.5 text-sm text-[#111a14] focus:border-[#164624] focus:outline-none"
        />
      </div>

      <label class="flex items-start gap-2.5 text-xs leading-relaxed text-[#516158]">
        <input name="privacidad" type="checkbox" required class="mt-0.5 h-4 w-4 accent-[#164624]" />
        <span>
          Acepto la{' '}
          <a href="/politica-de-privacidad/" class="font-semibold text-[#164624] underline">
            Política de Privacidad
          </a>{' '}
          para recibir el informe técnico y valorar mi obra sin compromiso. *
        </span>
      </label>

      <div id="lead-modal-status" class="hidden rounded-xl p-3 text-sm font-medium" role="status"></div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <button
          type="submit"
          class="inline-flex flex-1 items-center justify-center gap-2 rounded-full bg-[#164624] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0f331a]"
        >
          Enviar y generar PDF
        </button>
        <a
          href={`tel:${EMPRESA.telefonoE164}`}
          class="inline-flex items-center justify-center rounded-full border border-[#c6d9cb] px-4 py-3 text-sm font-semibold text-[#164624] hover:bg-[#eef3ee]"
        >
          {EMPRESA.telefonoVisible}
        </a>
      </div>
    </form>
  </div>
</dialog>

<script>
  const modal = document.getElementById('mbl-lead-modal') as HTMLDialogElement | null;
  const summaryEl = document.getElementById('lead-modal-summary');
  const formEl = document.getElementById('mbl-lead-modal-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('lead-modal-status');

  let currentContext = {
    concejo: 'Asturias',
    resumen: 'Cálculo orientativo en herramientas MBL',
  };

  window.addEventListener('mbl:open-lead-modal', (ev: Event) => {
    const custom = ev as CustomEvent<{ concejo?: string; resumen?: string }>;
    currentContext = {
      concejo: custom.detail?.concejo || 'Asturias',
      resumen: custom.detail?.resumen || 'Cálculo orientativo en herramientas MBL',
    };
    if (summaryEl) summaryEl.textContent = currentContext.resumen;
    if (statusEl) {
      statusEl.classList.add('hidden');
      statusEl.textContent = '';
    }
    modal?.showModal();
  });

  document.querySelectorAll('[data-close-lead-modal]').forEach((btn) => {
    btn.addEventListener('click', () => modal?.close());
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  formEl?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!formEl || !statusEl) return;

    const fd = new FormData(formEl);
    if (fd.get('empresa_web')) return;

    const nombre = String(fd.get('nombre') || '').trim();
    const telefono = String(fd.get('telefono') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const privacidad = fd.get('privacidad') === 'on';

    if (nombre.length < 2 || telefono.length < 9 || !email.includes('@') || !privacidad) {
      statusEl.className = 'rounded-xl bg-[#fdecea] p-3 text-sm font-medium text-[#61120c]';
      statusEl.textContent = 'Revisa nombre, teléfono, correo válido y aceptación de privacidad.';
      return;
    }

    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre,
          telefono,
          email,
          zona: currentContext.concejo,
          origen: 'simulador',
          privacidad: true,
          mensaje: `[Informe herramienta Asturias] ${currentContext.resumen}`,
        }),
      });

      if (!res.ok) throw new Error('HTTP error');

      statusEl.className = 'rounded-xl bg-[#eef3ee] p-3 text-sm font-medium text-[#164624]';
      statusEl.textContent = '¡Recibido! Preparando vista de impresión / PDF...';
      formEl.reset();
      window.setTimeout(() => {
        modal?.close();
        window.print();
      }, 650);
    } catch {
      statusEl.className = 'rounded-xl bg-[#fdecea] p-3 text-sm font-medium text-[#61120c]';
      statusEl.textContent = 'No se pudo enviar ahora mismo. Puedes imprimir esta pantalla o llamarnos al 684 675 898.';
    }
  });
</script>
