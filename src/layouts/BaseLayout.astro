---
import '@fontsource/bebas-neue/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import '../styles/global.css';

import SeoHead, { type Props as SeoProps } from '../components/SeoHead.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieBanner from '../components/CookieBanner.astro';

export interface Props extends SeoProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead {...seoProps} />
    <script is:inline>
      try {
        if (!localStorage.getItem('mbl_consent_v1')) {
          document.documentElement.classList.add('has-cookie-banner');
        }
      } catch (_e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

    <div class="frame">
      <slot name="header" />
      <main id="contenido-principal">
        <slot />
      </main>
      <Footer />
    </div>

    <WhatsAppFloat />
    <CookieBanner />

    <script is:inline defer src="/js/site-ui.js"></script>
    <script is:inline defer src="/js/mbl-select.js"></script>
  </body>
</html>
